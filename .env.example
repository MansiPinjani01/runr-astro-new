# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Main recipient email
EMAIL_TO=your-email@runr.in

# CC recipients
EMAIL_CC_1=cc1@runr.in
EMAIL_CC_2=cc2@runr.in

# From address (must be verified domain on Resend, or use onboarding@resend.dev for testing)
EMAIL_FROM=noreply@yourdomain.com
