---
/*
  Footer.astro - Site Footer Component
  Converted from: inc-footer.php
  
  Changes:
  1. $imagesurl → "/media/images/"
  2. $siteurl → "/"
  3. Social URLs hardcoded (update below with your actual URLs)
  4. date("Y") → JavaScript currentYear
  5. Copyright text hardcoded
  6. PHP if(isset($url)) conditions → direct conditional rendering
*/

// Social media URLs - UPDATE THESE WITH YOUR ACTUAL URLs
const instagramUrl = "https://www.instagram.com/findonrunr/";
const facebookUrl = "https://www.facebook.com/findonrunr";
const youtubeUrl = "https://www.youtube.com/@findonrunr";
//const linkedinUrl = "https://www.linkedin.com/company/runr";
const twitterUrl = ""; // Leave empty if not used

const currentYear = new Date().getFullYear();
---

<footer class="section-creative-footer" id="footer">
  <!-- Infinite Running Marquee / Ticker -->
  <div class="footer-marquee-wrap">
    <div class="footer-marquee-track">
      <div class="footer-marquee-content">
        <span>Runr</span>
        <span class="star">★</span>
        <span>Create</span>
        <span class="star">★</span>
        <span>Inspire</span>
        <span class="star">★</span>
        <span>Influence</span>
        <span class="star">★</span>
        <span>Reel Production</span>
        <span class="star">★</span>
        <span>Runr Kids</span>
        <span class="star">★</span>
      </div>
      <div class="footer-marquee-content">
        <span>Runr</span>
        <span class="star">★</span>
        <span>Create</span>
        <span class="star">★</span>
        <span>Inspire</span>
        <span class="star">★</span>
        <span>Influence</span>
        <span class="star">★</span>
        <span>Reel Production</span>
        <span class="star">★</span>
        <span>Runr Kids</span>
        <span class="star">★</span>
      </div>
      <div class="footer-marquee-content">
        <span>Runr</span>
        <span class="star">★</span>
        <span>Create</span>
        <span class="star">★</span>
        <span>Inspire</span>
        <span class="star">★</span>
        <span>Influence</span>
        <span class="star">★</span>
        <span>Reel Production</span>
        <span class="star">★</span>
        <span>Runr Kids</span>
        <span class="star">★</span>
      </div>
      <div class="footer-marquee-content">
        <span>Runr</span>
        <span class="star">★</span>
        <span>Create</span>
        <span class="star">★</span>
        <span>Inspire</span>
        <span class="star">★</span>
        <span>Influence</span>
        <span class="star">★</span>
        <span>Reel Production</span>
        <span class="star">★</span>
        <span>Runr Kids</span>
        <span class="star">★</span>
      </div>
    </div>
  </div>

  <div class="footer-main-container theme-padding">
    <div class="columns is-multiline footer-grid gap-2">
      <!-- Col 1: Brand Info & Live Status -->
      <div
        class="column is-12-mobile is-6-tablet is-4-desktop col-footer-brand"
      >
        <p class="footer-brand-desc">
          We craft <span class="theme-text fw-700">high-impact</span> reels, empower
          <span class="theme-text fw-700">content creators</span>, and connect
          brands with <span class="fw-700">voices</span> that <span
            class="theme-text fw-700">move people</span
          >.
        </p>
        <div
          class="footer-status-pill"
          onclick="openContactSidebar()"
          style="cursor:pointer;"
        >
          <span class="pulse-dot"></span>
          <span>Available for Collaborations</span>
        </div>
      </div>

      <!-- Col 3: Contact & Address -->
      <div
        class="column is-12-mobile is-6-tablet is-4-desktop col-footer-contact"
      >
        <h4 class="footer-col-title">Get in Touch</h4>
        <div class="footer-contact-info">
          <div class="contact-info-block">
            <span class="info-label">Address</span>
            <p>
              401, 4<sup>th</sup> Floor, Trishul One, Sir. P. Pattani Road, Ghogha
              Circle, Bhavnagar - 364001, Gujarat, India
            </p>
          </div>
          <div class="contact-info-block">
            <span class="info-label">Direct Lines</span>
            <p><a href="mailto:info@runr.in">info@runr.in</a></p>
            <p><a href="tel:+918877555255">+91 88775 55255</a></p>
          </div>
        </div>
      </div>

      <!-- Col 4: Social Channels -->
      <div
        class="column is-12-mobile is-12-tablet is-4-desktop col-footer-social"
      >
        <h4 class="footer-col-title">Follow Our Journey</h4>
        <div class="footer-social-grid">
          {
            instagramUrl && (
              <a href={instagramUrl} target="_blank" class="social-pill-btn">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                </svg>
                <span>Instagram</span>
              </a>
            )
          }
          <a
            href="https://api.whatsapp.com/send?phone=918877555255"
            target="_blank"
            class="social-pill-btn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
              ></path>
            </svg>
            <span>WhatsApp</span>
          </a>
          {
            facebookUrl && (
              <a href={facebookUrl} target="_blank" class="social-pill-btn">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                </svg>
                <span>Facebook</span>
              </a>
            )
          }
          {
            youtubeUrl && (
              <a href={youtubeUrl} target="_blank" class="social-pill-btn">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" />
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" />
                </svg>
                <span>YouTube</span>
              </a>
            )
          }
          {
            twitterUrl && (
              <a href={twitterUrl} target="_blank" class="social-pill-btn">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
                </svg>
                <span>Twitter</span>
              </a>
            )
          }
        </div>
      </div>
    </div>

    <!-- Giant Logo with separator -->
    <div class="footer-separator"></div>
    <div class="copyright-bar">
      <div class="columns is-multiline is-vcentered row-copyright">
        <div
          class="column is-12-mobile is-8-tablet is-8-desktop is-8-widescreen col-copyright"
        >
          <div class="copyright-detail">
            <small
              >&copy; {currentYear} runr. All Rights Reserved. by Midnight Digital
              Pvt. Ltd.</small
            >
          </div>
        </div>
        <div
          class="column is-12-mobile is-4-tablet is-4-desktop is-4-widescreen col-copyright"
        >
          <ul class="footer-menu">
            <li>
              <small><a href="/privacy-policy/">Privacy Policy</a></small>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-runr-logo">
      <img
        src="/media/images/gray-logo.svg"
        alt="Runr Logo"
        class="logo grey"
      />
      <div class="orange-reveal">
        <img
          src="/media/images/orange-logo.svg"
          alt="Runr Logo"
          class="logo orange"
        />
      </div>
      <div class="flash"></div>
    </div>
  </div>
</footer>

<button class="scroll-to-top" aria-label="Scroll to top">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>
