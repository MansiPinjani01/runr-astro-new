---
/*
  FootScripts.astro - Footer Scripts Component
  Converted from: inc-foot-scripts.php
  
  - Common JS loaded on all pages (jQuery, GSAP, Lenis, ScrollTrigger)
  - Conditional JS loaded based on page flags (Swiper, Splide, Fancybox)
  - GSAP image reveal animations
  - Lenis smooth scroll initialization
  - One-page-menu smooth scroll behavior
  
  Note: <script is:inline> tells Astro to pass JS directly to browser without bundling.
  This preserves original behavior of the existing scripts.
*/

interface Props {
  slider?: boolean;
  swiperjs?: boolean;
  popup?: boolean;
  counter?: boolean;
  onepagemenu?: boolean;
}

const {
  slider = false,
  swiperjs = false,
  popup = false,
  counter = false,
  onepagemenu = false,
} = Astro.props;
---
<style is:global>
  .split-line {
    overflow: hidden !important;
    display: inline-block !important;
    vertical-align: top;
  }
</style>

<!-- Common JS - Loaded on all pages -->
<script is:inline src="/media/js/all-js.js"></script>
<script is:inline src="/media/js/lenis.min.js"></script>
<script is:inline src="/media/js/gsap.min.js"></script>
<script is:inline src="/media/js/ScrollTrigger.min.js"></script>
<script is:inline src="/media/js/SplitText.min.js"></script>

<!-- Conditional: Swiper JS -->
{swiperjs && <script is:inline src="/media/js/swiper-bundle.min.js"></script>}

<!-- Conditional: Splide Slider JS -->
{slider && <script is:inline src="/media/js/splide.min.js"></script>}

<!-- Fancybox JS - Loaded on all pages -->
<script is:inline src="/media/js/fancybox.js"></script>

<!-- Conditional: Counter Animation -->
{counter && (
<script is:inline>
(function() {
  'use strict';
  function animateCounters() {
    var counters = document.querySelectorAll('.purecounter');
    if (!counters.length) return;

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var el = entry.target;
          var end = parseInt(el.getAttribute('data-purecounter-end')) || 0;
          var start = parseInt(el.getAttribute('data-purecounter-start')) || 0;
          var duration = 2;
          var obj = { val: start };

          gsap.to(obj, {
            val: end,
            duration: duration,
            ease: 'power2.out',
            onUpdate: function() {
              var separator = el.getAttribute('data-purecounter-separator') === 'true';
              var symbol = el.getAttribute('data-purecounter-separatorsymbol') || ',';
              var current = Math.floor(obj.val);
              if (separator) {
                el.textContent = current.toString().replace(/\B(?=(\d{3})+(?!\d))/g, symbol);
              } else {
                el.textContent = current;
              }
            }
          });

          observer.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    counters.forEach(function(el) {
      observer.observe(el);
    });
  }

  if (document.readyState === 'complete') { animateCounters(); }
  else { window.addEventListener('load', animateCounters); }
})();
</script>
)}

<!-- Custom JS -->
<script is:inline src="/media/js/all-custom.js"></script>

<!-- GSAP Image Reveal Effects (from inc-foot-scripts.php) -->
<script is:inline>
(function() {
  'use strict';
  function initGSAP() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initGSAP, 100);
      return;
    }
    if (typeof SplitText !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger, SplitText);
    } else {
      gsap.registerPlugin(ScrollTrigger);
    }

    function ensureRelative(el) {
      if (window.getComputedStyle(el).position === 'static') {
        el.style.position = 'relative';
      }
    }

    /* EFFECT 1 ” CURTAIN SLICE */
    document.querySelectorAll('.img-reveal-slice').forEach(function(wrap) {
      var img = wrap.querySelector('img');
      if (!img) return;
      ensureRelative(wrap);
      gsap.set(img, { scale: 1.1, transformOrigin: 'center center', force3D: true });
      var curtain = document.createElement('span');
      curtain.setAttribute('aria-hidden', 'true');
      curtain.style.cssText = [
        'position:absolute', 'top:0', 'left:0', 'right:0', 'bottom:0',
        'background-color:' + (wrap.dataset.curtain || '#ff5722'),
        'z-index:3', 'display:block', 'transform-origin:top center', 'will-change:transform'
      ].join(';');
      wrap.appendChild(curtain);
      gsap.timeline({ scrollTrigger: { trigger: wrap, start: 'top 88%', once: true } })
        .to(curtain, { yPercent: 101, duration: 0.85, ease: 'power4.inOut' })
        .to(img, { scale: 1, duration: 1.1, ease: 'power3.out' }, 0);
    });

        /* EFFECT 2 — VENETIAN SHUTTER (Services section) */
    document.querySelectorAll('.img-reveal-shutter').forEach(function(wrap) {
      var img = wrap.querySelector('img');
      if (!img) return;
      ensureRelative(wrap);
      gsap.set(img, { filter: 'grayscale(100%)' });
      var STRIPS = 6;
      var color = wrap.dataset.curtain || '#000';
      var panels = [];
      var pW = (100 / STRIPS).toFixed(4) + '%';
      for (var i = 0; i < STRIPS; i++) {
        var panel = document.createElement('span');
        panel.setAttribute('aria-hidden', 'true');
        panel.style.cssText = 'position:absolute;top:0;left:' + ((i / STRIPS) * 100).toFixed(4) + '%;width:' + pW + ';height:100%;background-color:' + color + ';z-index:3;transform-origin:left center;will-change:transform';
        wrap.appendChild(panel);
        panels.push(panel);
      }
      gsap.timeline({ scrollTrigger: { trigger: wrap, start: 'top 88%', once: true } })
        .to(panels, { scaleX: 0, duration: 0.65, ease: 'power3.inOut', stagger: 0.07 })
        .to(img, { filter: 'grayscale(0%)', duration: 0.4, ease: 'power2.out' }, '-=0.4');
    });

    /* EFFECT 3 ” DIAGONAL WIPE */
    document.querySelectorAll('.img-reveal-diagonal').forEach(function(wrap) {
      var img = wrap.querySelector('img');
      if (!img) return;
      ensureRelative(wrap);
      wrap.style.overflow = 'hidden';
      gsap.set(img, { scale: 1.12, transformOrigin: 'center center', force3D: true });
      var mask = document.createElement('span');
      mask.setAttribute('aria-hidden', 'true');
      mask.style.cssText = [
        'position:absolute', 'top:0', 'left:0', 'width:150%', 'height:150%',
        'background:' + (wrap.dataset.diagonal || '#ff5722'),
        'z-index:3', 'transform:rotate(-45deg) translate(-20%,-80%)',
        'transform-origin:center center', 'will-change:transform'
      ].join(';');
      wrap.appendChild(mask);
      gsap.timeline({ scrollTrigger: { trigger: wrap, start: 'top 85%', once: true } })
        .to(mask, { yPercent: 200, duration: 0.9, ease: 'power3.inOut' })
        .to(img, { scale: 1, duration: 1.1, ease: 'power2.out' }, 0.1);
    });



    /* Scroll-triggered fade-in for .js-scroll */
    var scrollEls = document.querySelectorAll('.js-scroll');
    if (scrollEls.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('scrolled');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      scrollEls.forEach(function(el) { observer.observe(el); });
    }
  }
  if (document.readyState === 'complete') { initGSAP(); }
  else { window.addEventListener('load', initGSAP); }
})();
</script>

<!-- Footer Logo Animation -->
<script is:inline>
(function() {
  if (typeof gsap === 'undefined') return;
  var footerLogo = document.querySelector('.footer-runr-logo');
  if (!footerLogo) return;
  var logoWidth = footerLogo.offsetWidth || 1200;

  var tl = gsap.timeline({ repeat: -1, repeatDelay: 2.5 });
  tl.set(".footer-runr-logo .flash", { x: -150, opacity: 0 })
    .set(".footer-runr-logo .orange-reveal", { clipPath: "inset(0 100% 0 0)" })
    .to(".footer-runr-logo .flash", { opacity: 1, x: logoWidth + 150, duration: 0.8, ease: "power1.inOut" })
    .to(".footer-runr-logo .orange-reveal", { clipPath: "inset(0 0% 0 0)", duration: 0.8, ease: "power1.inOut" }, "<")
    .to(".footer-runr-logo .flash", { opacity: 0, duration: 0.1 })
    .to(".footer-runr-logo .orange-reveal", { clipPath: "inset(0 100% 0 0)", duration: 0.5, ease: "power2.in", delay: 1.2 });
})();
</script>

<!-- Lenis Smooth Scroll Init -->
<script is:inline>
(function() {
  'use strict';
  if (typeof Lenis === 'undefined') return;

  var lenis = new Lenis({
    duration: 1.2,
    easing: function(t) { return Math.min(1, 1.001 - Math.pow(2, -10 * t)); },
    smoothWheel: true,
  });

  window.lenis = lenis;

  if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add(function(time) {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);
  } else {
    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
  }
})();
</script>

<!-- One Page Menu (Smooth scroll to anchors) -->
{onepagemenu && (
  <script is:inline>
  (function() {
    'use strict';
    var headerHeight = document.querySelector('#header') ? document.querySelector('#header').clientHeight : 80;
    document.addEventListener('click', function(e) {
      var link = e.target.closest('a[href*="#"]');
      if (!link) return;
      var hash = link.getAttribute('href');
      if (!hash || hash === '#') return;
      var target = document.querySelector(hash);
      if (!target) return;
      e.preventDefault();
      if (window.lenis) {
        window.lenis.scrollTo(target, { offset: -headerHeight, duration: 1.2 });
      } else {
        var top = target.getBoundingClientRect().top + window.pageYOffset - headerHeight;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    });
  })();
  </script>
)}

<!-- Title Animate & CTA Headline (Char Split + GSAP Reveal) -->
<script is:inline>
(function() {
  'use strict';
  function splitTextToWords(text, container) {
    var words = text.split(' ');
    for (var w = 0; w < words.length; w++) {
      if (w > 0) {
        var space = document.createElement('span');
        space.className = 'char word-space';
        space.innerHTML = ' ';
        space.style.display = 'inline';
        container.appendChild(space);
      }
      var wordSpan = document.createElement('span');
      wordSpan.className = 'word';
      wordSpan.style.whiteSpace = 'nowrap';
      for (var c = 0; c < words[w].length; c++) {
        var charSpan = document.createElement('span');
        charSpan.className = 'char';
        charSpan.textContent = words[w][c];
        wordSpan.appendChild(charSpan);
      }
      container.appendChild(wordSpan);
    }
  }

  function splitChars(el) {
    if (!el) return;
    var nodes = Array.prototype.slice.call(el.childNodes);
    var frag = document.createDocumentFragment();
    for (var i = 0; i < nodes.length; i++) {
      var node = nodes[i];
      if (node.nodeType === 3) {
        var text = node.textContent;
        splitTextToWords(text, frag);
      } else if (node.nodeType === 1) {
        if (node.tagName.toLowerCase() === 'br') {
          frag.appendChild(node.cloneNode(true));
        } else {
          var clone = node.cloneNode(false);
          clone.style.display = clone.style.display || '';
          var childNodes = Array.prototype.slice.call(node.childNodes);
          for (var k = 0; k < childNodes.length; k++) {
            var childNode = childNodes[k];
            if (childNode.nodeType === 3) {
              splitTextToWords(childNode.textContent, clone);
            } else if (childNode.nodeType === 1) {
              if (childNode.tagName.toLowerCase() === 'br') {
                clone.appendChild(childNode.cloneNode(true));
              } else {
                var nestedClone = childNode.cloneNode(false);
                splitTextToWords(childNode.textContent, nestedClone);
                clone.appendChild(nestedClone);
              }
            }
          }
          frag.appendChild(clone);
        }
      }
    }
    el.innerHTML = '';
    el.appendChild(frag);
  }

  var animHeadings = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'span', 'p'];
  var sections = document.querySelectorAll('.section-title.title-animate');

  sections.forEach(function(section) {
    var tag = section.tagName.toLowerCase();
    if (animHeadings.indexOf(tag) !== -1) {
      splitChars(section);
    } else {
      var children = Array.prototype.slice.call(section.children);
      for (var c = 0; c < children.length; c++) {
        var childTag = children[c].tagName.toLowerCase();
        if (animHeadings.indexOf(childTag) !== -1) {
          splitChars(children[c]);
        }
      }
    }

    var allChars = section.querySelectorAll('.char');
    if (!allChars.length) return;

    gsap.set(allChars, { y: 100, opacity: 0 });

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          gsap.to(allChars, {
            y: 0,
            opacity: 1,
            duration: 0.8,
            ease: "power4.out",
            stagger: 0.03
          });
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  });

  /* CTA Headline Animation */
  var ctaHeadline = document.querySelector('.cta-headline');
  if (ctaHeadline) {
    var ctaLines = ctaHeadline.querySelectorAll('[data-cta="line"]');
    for (var i = 0; i < ctaLines.length; i++) {
      splitChars(ctaLines[i]);
    }
    var ctaChars = ctaHeadline.querySelectorAll('.char');
    if (ctaChars.length) {
      gsap.set(ctaChars, { y: 100, opacity: 0 });
      var ctaObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            gsap.to(ctaChars, {
              y: 0,
              opacity: 1,
              duration: 0.8,
              ease: "power4.out",
              stagger: 0.03
            });
            ctaObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      ctaObserver.observe(ctaHeadline);
    }
  }
})();
</script>

<!-- Menu Toggle Functions -->
<script is:inline>
function menuresponsive() {
  const body = document.body;
  const html = document.documentElement;
  if (body.classList.contains('insomenu-active')) {
    menuresponsiveclose();
  } else {
    body.classList.add('insomenu-active');
    html.classList.add('insomenu-active');
    if (window.lenis) window.lenis.stop();
    // Play video when menu opens
    const vid = document.querySelector('.menu-header-video');
    if (vid) vid.play();
  }
}
function menuresponsiveclose() {
  const body = document.body;
  const html = document.documentElement;
  const menu = document.querySelector('.theme-menu');
  if (menu) {
    menu.classList.add('closing');
    // Reset nav items
    setTimeout(function() {
      body.classList.remove('insomenu-active');
      html.classList.remove('insomenu-active');
      menu.classList.remove('closing');
      if (window.lenis) window.lenis.start();
    }, 700);
  } else {
    body.classList.remove('insomenu-active');
    html.classList.remove('insomenu-active');
    if (window.lenis) window.lenis.start();
  }
}
function openForm(type) {
  document.getElementById('register-modal').classList.add('is-active');
}
function closeForm() {
  document.getElementById('register-modal').classList.remove('is-active');
}
</script>

<!-- Custom Cursor -->
<script is:inline>
(function() {
  var dot = document.querySelector('.cursor-dot');
  var ring = document.querySelector('.cursor-ring');
  if (!dot || !ring) return;

  var dotX = gsap.quickTo(dot, "x", { duration: 0.08, ease: "power3" });
  var dotY = gsap.quickTo(dot, "y", { duration: 0.08, ease: "power3" });
  var ringX = gsap.quickTo(ring, "x", { duration: 0.35, ease: "power3" });
  var ringY = gsap.quickTo(ring, "y", { duration: 0.35, ease: "power3" });

  window.addEventListener('mousemove', function(e) {
    dotX(e.clientX);
    dotY(e.clientY);
    ringX(e.clientX);
    ringY(e.clientY);
  });

  var RING_DEFAULT = { scale: 1, opacity: 1, backgroundColor: 'transparent', border: '1px solid #ff5722', duration: 0.3 };
  var DOT_DEFAULT = { scale: 1, duration: 0.2 };

  function resetRing() {
    ring.classList.remove('is-view');
    gsap.to(ring, RING_DEFAULT);
    gsap.to(dot, DOT_DEFAULT);
  }

  function bindCursorHovers() {
    document.querySelectorAll('a, button').forEach(function(el) {
      el.addEventListener('mouseenter', function() {
        gsap.to(ring, { scale: 1.5, backgroundColor: '#ff5b1f53', border: '1px solid #ff5722', opacity: 1, duration: 0.35 });
        gsap.to(dot, { scale: 0, duration: 0.2 });
      });
      el.addEventListener('mouseleave', resetRing);
    });
  }
  bindCursorHovers();

  // VIEW cursor for Runr Reels section
  var reelsSection = document.querySelector('#section-runr-shots');
  if (reelsSection) {
    function bindReelSlides() {
      reelsSection.querySelectorAll('.swiper-slide').forEach(function(slide) {
        if (slide.dataset.viewCursorBound) return;
        slide.dataset.viewCursorBound = '1';
        slide.addEventListener('mouseenter', function() {
          ring.classList.add('is-view');
          gsap.to(ring, { scale: 1.8, opacity: 1, backgroundColor: '#ff5722', border: '1px solid #ffffff8c', duration: 0.3, ease: 'power3.out' });
          gsap.to(dot, { scale: 0, duration: 0.2 });
        });
        slide.addEventListener('mouseleave', resetRing);
      });
    }
    bindReelSlides();
    setTimeout(bindReelSlides, 800);
    setTimeout(bindReelSlides, 2000);
  }
})();
</script>
