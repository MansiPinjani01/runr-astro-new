---
/*
  BaseLayout.astro - Master Layout
  ================================
  Common page structure (replaces inc-head.php + HTML skeleton).
  
  Props:
  - title: Page title for SEO
  - page: Page ID for HTML id attribute
  - pagename: Display name
  - description: SEO description
  - keywords: SEO keywords
  - slider: Load Splide CSS
  - swiperjs: Load Swiper CSS
  - popup: Load Fancybox CSS
  - bodyClass: Extra body class (optional)
*/

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FootScripts from '../components/FootScripts.astro';

interface Props {
  title?: string;
  page?: string;
  pagename?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  slider?: boolean;
  swiperjs?: boolean;
  popup?: boolean;
  counter?: boolean;
  onepagemenu?: boolean;
  bodyClass?: string;
}

const {
  title = "runr",
  page = "home",
  pagename = "Home",
  description = "runr - Create. Inspire. Influence.",
  keywords = "runr, digital media, content creation",
  image = "seo",
  canonical,
  noindex = false,
  slider = false,
  swiperjs = false,
  popup = false,
  counter = false,
  onepagemenu = false,
  bodyClass = "",
} = Astro.props;

const version = "1.1.0";
const canonicalUrl = canonical || `https://www.runr.in${Astro.url.pathname === '/' ? '/' : Astro.url.pathname + '/'}`;
---

<!DOCTYPE html>
<html id={page} dir="ltr" lang="en-US">

<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-C20CFV3BSW"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag("js", new Date());

    gtag("config", "G-C20CFV3BSW");
    console.log("googleanalytics");
  </script>

  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Bulma Custom (merged from PHP style files) -->
  <link rel="stylesheet" type="text/css" href="/media/css/bulma-custom.css">

  
  <!-- Conditional: Splide Slider CSS -->
  {slider && <link rel="stylesheet" type="text/css" href="/media/css/splide-inline.css">}

  <!-- Fancybox CSS -->
  <link rel="stylesheet" type="text/css" href="/media/css/fancybox-inline.css">

  <!-- Conditional: Swiper CSS -->
  {swiperjs && <link rel="stylesheet" type="text/css" href="/media/css/swiper-bundle.min.css">}

  <!-- Main Custom CSS -->
  <link rel="stylesheet" type="text/css" href={`/media/css/all-custom.css?${version}`}>
  <link rel="stylesheet" type="text/css" href={`/media/css/all-responsive.css?${version}`}>

  <!-- Section-specific CSS -->
  <link rel="stylesheet" type="text/css" href="/media/css/client-logos-orbit.css">
  <link rel="stylesheet" type="text/css" href="/media/css/editorial-cta.css">
  <link rel="stylesheet" type="text/css" href="/media/css/shots.css">
  <!-- SEO Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content={keywords}>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/media/favicon/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/media/favicon/apple-icon-180x180.png">

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={`/media/images/seo/${image}.jpg`}>

  <!-- Sitewide Organization Schema -->
  <script type="application/ld+json" is:inline>{`
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Runr",
      "url": "https://www.runr.in/",
      "logo": "https://www.runr.in/assets/runr-logo.png",
      "description": "Runr is a human-led creative consulting studio offering marketing strategy consulting, content creation, influencer marketing, podcast production, and branding for brands and entrepreneurs across India.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "401, 4th Floor, Trishul One, Sir P. Pattani Road, Ghogha Circle",
        "addressLocality": "Bhavnagar",
        "addressRegion": "Gujarat",
        "postalCode": "364001",
        "addressCountry": "IN"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+91-88775-55255",
        "contactType": "customer service",
        "email": "info@runr.in"
      },
      "sameAs": [
        "https://www.instagram.com/findonrunr"
      ]
    }
  `}</script>

  <!-- Extra head content from pages (slot) -->
  <slot name="head" />
</head>

<body class={bodyClass}>

  <Header />

  <!-- Page Content (slot) - Each page's unique content goes here -->
  <slot />

  <Footer />

  <FootScripts 
    slider={slider} 
    swiperjs={swiperjs} 
    popup={popup} 
    counter={counter} 
    onepagemenu={onepagemenu} 
  />

  <!-- Page-specific scripts (loaded AFTER common libraries) -->
  <slot name="page-scripts" />

</body>
</html>
