  <Fragment slot="page-scripts">
    <script is:inline src="/media/js/client-logos-orbit.js"></script>

    <script is:inline>
      // // Loader
      const SHOW_LOADER = false;

      if (!SHOW_LOADER) {
        loader.style.display = "none";
        homepage.style.opacity = "1";

        window.dispatchEvent(new Event("facesInit"));
      } else {
        (function () {
          const loader = document.getElementById("loader");
          const video = document.getElementById("logo-video");
          const homepage = document.getElementById("homepage");
          const body = document.body;
          let transitioned = false;
          let fallbackTimer = setTimeout(runTransition, 8000);

          const glitchLines = document.querySelectorAll(
            "#section-brand-story .theme-glitch-text",
          );
          const lineTop = glitchLines[0];
          const lineMid = glitchLines[1];
          const lineBottom = glitchLines[2];
          const subtitle = document.querySelector(
            "#section-brand-story .story-subtitle",
          );

          const videosTop = document.querySelectorAll(
            "#section-brand-story .vid1, #section-brand-story .vid2",
          );
          const videoMid = document.querySelectorAll(
            "#section-brand-story .vid3",
          );
          const videosBottom = document.querySelectorAll(
            "#section-brand-story .vid4, #section-brand-story .vid5",
          );

          document.documentElement.style.overflow = "hidden";

          const scrollY = window.scrollY || window.pageYOffset;
          const centerY = scrollY + window.innerHeight / 2;

          gsap.set(loader, {
            clipPath: "circle(150vmax at 50% 50vh)",
          });
          gsap.set(homepage, {
            clipPath: `circle(0vmax at 50% ${centerY}px)`,
            scale: 1.06,
          });
          gsap.set([lineTop, lineMid, lineBottom], {
            clipPath: "inset(0 100% 0 0)",
          });
          gsap.set(subtitle, {
            opacity: 0,
            y: 20,
          });
          gsap.set([videosTop, videoMid, videosBottom], {
            opacity: 0,
            scale: 0.94,
          });

          video.addEventListener("ended", runTransition, {
            once: true,
          });

          video.play().catch(() => {
            const resume = () => {
              video.play();
              window.removeEventListener("click", resume);
            };
            window.addEventListener("click", resume, {
              once: true,
            });
          });

          function runTransition() {
            if (transitioned) return;
            transitioned = true;
            clearTimeout(fallbackTimer);

            body.classList.remove("is-loading");
            gsap.set(loader, {
              pointerEvents: "none",
            });

            const tl = gsap.timeline({
              onComplete: () => {
                document.documentElement.style.overflow = "";
                loader.style.display = "none";
                gsap.set(homepage, {
                  clipPath: "none",
                });
                // Loader animation done ” initialize everything
                window.dispatchEvent(new Event("facesInit"));
                window.dispatchEvent(new Event("runrLoaderComplete"));
                ScrollTrigger.refresh();
              },
            });

            // 1. Logo shrinks into the center point and fades
            tl.to(
              video,
              {
                scale: 0.5,
                opacity: 0,
                duration: 0.8,
                ease: "power2.in",
              },
              0,
            );

            // 2. Loader itself closes like a camera aperture, into that same point
            tl.to(
              loader,
              {
                clipPath: "circle(0vmax at 50% 50vh)",
                duration: 1.1,
                ease: "power4.inOut",
              },
              0.05,
            );

            // 3. Homepage opens outward from that exact point ” the "lens
            // reopening on the new scene" moment that ties both halves together
            tl.to(
              homepage,
              {
                clipPath: `circle(150vmax at 50% ${centerY}px)`,
                scale: 1,
                duration: 1.3,
                ease: "power4.inOut",
              },
              0.75,
            );

            // 4. Hero wipes in, top to bottom, in sync with the aperture opening
            tl.to(
              videosTop,
              {
                opacity: 1,
                scale: 1,
                duration: 0.9,
                stagger: 0.08,
                ease: "expo.out",
              },
              1.05,
            )
              .to(
                lineTop,
                {
                  clipPath: "inset(0 0% 0 0)",
                  duration: 0.9,
                  ease: "power4.inOut",
                },
                1.08,
              )

              .to(
                videoMid,
                {
                  opacity: 1,
                  scale: 1,
                  duration: 0.9,
                  ease: "expo.out",
                },
                1.3,
              )
              .to(
                lineMid,
                {
                  clipPath: "inset(0 0% 0 0)",
                  duration: 0.9,
                  ease: "power4.inOut",
                },
                1.33,
              )

              .to(
                videosBottom,
                {
                  opacity: 1,
                  scale: 1,
                  duration: 0.9,
                  stagger: 0.08,
                  ease: "expo.out",
                },
                1.55,
              )
              .to(
                lineBottom,
                {
                  clipPath: "inset(0 0% 0 0)",
                  duration: 0.9,
                  ease: "power4.inOut",
                },
                1.58,
              )
              .to(
                subtitle,
                {
                  opacity: 1,
                  y: 0,
                  duration: 0.8,
                  ease: "expo.out",
                },
                1.8,
              );
          }
        })();
      }

      // Service Block Active State & Stacking Cards Effect
      if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
        gsap.registerPlugin(ScrollTrigger);

        var serviceBlocks = gsap.utils.toArray(".service-block");

        serviceBlocks.forEach(function (block, index) {
          var blackText = block.querySelector(".black");

          if (blackText) {
            gsap.to(blackText, {
              clipPath: "inset(0 0% 0 0)",
              ease: "none",
              scrollTrigger: {
                trigger: block,
                start: "top center",
                end: "bottom center",
                scrub: true,
              },
            });
          }

          // Card Stacking Scale Effect
          if (index < serviceBlocks.length - 1) {
            gsap.to(block, {
              scale: 0.92,
              opacity: 0.5,
              filter: "blur(5px)",
              ease: "none",
              scrollTrigger: {
                trigger: serviceBlocks[index + 1],
                start: "top bottom-=100",
                end: "top top+=140",
                scrub: true,
              },
            });
          }
        });
      }
    </script>

