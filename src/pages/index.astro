    <script is:inline>
      const shotsSwiper = new Swiper("#section-runr-shots .shots-swiper", {
        effect: "coverflow",
        grabCursor: true,
        centeredSlides: true,
        slidesPerView: "auto",
        spaceBetween: 0,
        loop: true,
        preventClicks: false,
        preventClicksPropagation: false,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        coverflowEffect: {
          rotate: 15,
          stretch: 0,
          depth: 120,
          modifier: 1,
          slideShadows: false,
        },
        breakpoints: {
          0: {
            coverflowEffect: {
              rotate: 10,
              stretch: 0,
              depth: 80,
              modifier: 1,
              slideShadows: false,
            },
          },
          768: {
            coverflowEffect: {
              rotate: 15,
              stretch: 0,
              depth: 120,
              modifier: 1,
              slideShadows: false,
            },
          },
        },
        on: {
          init() {
            const self = this;
            alignIgFrame(self);
            setTimeout(() => alignIgFrame(self), 50);
            setTimeout(() => alignIgFrame(self), 250);
          },
          resize() {
            alignIgFrame(this);
          },
        },
      });

      window.addEventListener("resize", () => {
        if (typeof shotsSwiper !== "undefined" && shotsSwiper) {
          alignIgFrame(shotsSwiper);
        }
      });

      // Align sticky Instagram frame perfectly over active slide
      function alignIgFrame(swiperInstance) {
        if (!swiperInstance) return;
        const igFrame = document.querySelector(
          "#section-runr-shots .ig-frame-sticky",
        );
        const firstSlide = document.querySelector(
          "#section-runr-shots .shots-swiper .swiper-slide",
        );

        if (firstSlide && igFrame) {
          // Only set width to match slide, height auto (determined by content)
          igFrame.style.width = firstSlide.offsetWidth + "px";
        }
      }

      if (typeof Fancybox !== "undefined") {
        Fancybox.bind('[data-fancybox="runr-shots"]', {
          Toolbar: {
            display: ["close"],
          },
        });
      }

      // Split text for influencer hover animation
      const elements = document.querySelectorAll(".influencer-name-wrap .txt");
      elements.forEach(function (el) {
        const text = el.textContent.trim();
        el.textContent = "";
        text.split("").forEach(function (letter, i) {
          const ch = document.createElement("span");
          ch.className = "ch";
          ch.textContent = letter === " " ? "\u00A0" : letter;
          ch.style.transitionDelay = i * 0.02 + "s";
          el.appendChild(ch);
        });
      });
    </script>
