  <Fragment slot="page-scripts">
    <script is:inline src="/media/js/client-logos-orbit.js"></script>

    <!-- Music Swiper Init & Player Logic -->
    <script is:inline>
      (function () {
        if (typeof Swiper === "undefined") return;
        new Swiper(".music-swiper", {
          slidesPerView: 2,
          spaceBetween: 20,
          loop: true,
          loopAdditionalSlides: 2,

          autoplay: {
            delay: 3000,
            disableOnInteraction: false,
          },

          pagination: false,

          breakpoints: {
            1216: {
              slidesPerView: 1,
            },
            1408: {
              slidesPerView: 2,
            },
          },
        });

        // Player Logic
        const audio = document.getElementById("runr-audio");
        const playBtn = document.getElementById("main-play-btn");
        const topPlayBtn = document.getElementById("top-play-btn");
        const prevBtn = document.querySelector(".prev-btn");
        const nextBtn = document.querySelector(".next-btn");
        const playIcon = document.getElementById("play-icon");
        const pauseIcon = document.getElementById("pause-icon");
        const diskImg = document.getElementById("music-disk");

        const currentTimeEl = document.getElementById("current-time");
        const durationEl = document.getElementById("duration");
        const progressContainer = document.getElementById("progress-container");
        const progressFill = document.getElementById("progress-fill");

        const playerTitle = document.getElementById("player-title");
        const playerSinger = document.getElementById("player-singer");

        const slides = document.querySelectorAll(
          ".swiper-slide[data-audio]:not(.swiper-slide-duplicate)",
        );
        let playlist = [];
        let currentTrackIndex = 0;

        if (slides) {
          slides.forEach((slide, index) => {
            playlist.push({
              src: slide.getAttribute("data-audio"),
              title: slide.getAttribute("data-title"),
              singer: slide.getAttribute("data-singer"),
              originalSlide: slide,
            });
            // Update click event to use playlist index
            slide.addEventListener("click", () => {
              playTrack(index);
            });
          });
        }

        // Add events to duplicated slides so they also work
        const allSlides = document.querySelectorAll(
          ".swiper-slide[data-audio]",
        );
        allSlides.forEach((slide) => {
          if (slide.classList.contains("swiper-slide-duplicate")) {
            slide.addEventListener("click", () => {
              const src = slide.getAttribute("data-audio");
              const index = playlist.findIndex((track) => track.src === src);
              if (index !== -1) playTrack(index);
            });
          }
        });

        function playTrack(index) {
          if (index < 0 || index >= playlist.length) return;
          const track = playlist[index];

          if (track.title && playerTitle) playerTitle.textContent = track.title;
          if (track.singer && playerSinger)
            playerSinger.textContent = track.singer;

          currentTrackIndex = index;

          if (track.src && track.src !== "") {
            const currentSrc = new URL(audio.src, window.location.href).href;
            const newSrc = new URL(track.src, window.location.href).href;

            if (currentSrc !== newSrc) {
              audio.src = track.src;
              audio.play();
            } else {
              togglePlay();
            }
          } else {
            audio.pause();
            alert("This song is not available yet.");
          }
        }

        function playNext() {
          if (playlist.length === 0) return;
          let nextIndex = (currentTrackIndex + 1) % playlist.length;
          playTrack(nextIndex);
        }

        function playPrev() {
          if (playlist.length === 0) return;
          let prevIndex =
            (currentTrackIndex - 1 + playlist.length) % playlist.length;
          playTrack(prevIndex);
        }

        if (nextBtn) nextBtn.addEventListener("click", playNext);
        if (prevBtn) prevBtn.addEventListener("click", playPrev);

        function togglePlay() {
          if (audio.paused) {
            if (
              audio.src &&
              audio.src !== window.location.href &&
              audio.src !== ""
            ) {
              audio.play();
            } else if (playlist.length > 0) {
              playTrack(0);
            }
          } else {
            audio.pause();
          }
        }

        if (playBtn) playBtn.addEventListener("click", togglePlay);
        if (topPlayBtn) topPlayBtn.addEventListener("click", togglePlay);

        function updatePlayState() {
          if (audio.paused) {
            if (playIcon) playIcon.style.display = "block";
            if (pauseIcon) pauseIcon.style.display = "none";
            if (diskImg) diskImg.classList.remove("playing");
          } else {
            if (playIcon) playIcon.style.display = "none";
            if (pauseIcon) pauseIcon.style.display = "block";
            if (diskImg) diskImg.classList.add("playing");
          }
        }

        if (audio) {
          audio.addEventListener("play", updatePlayState);
          audio.addEventListener("pause", updatePlayState);
          audio.addEventListener("ended", () => {
            playNext(); // Auto play next when ended
          });

          audio.addEventListener("timeupdate", () => {
            const currentTime = audio.currentTime;
            const duration = audio.duration || 0;
            if (duration) {
              const progressPercent = (currentTime / duration) * 100;
              if (progressFill)
                progressFill.style.width = progressPercent + "%";
              if (currentTimeEl)
                currentTimeEl.textContent = formatTime(currentTime);
              if (durationEl) durationEl.textContent = formatTime(duration);
            }
          });

          audio.addEventListener("loadedmetadata", () => {
            if (durationEl) durationEl.textContent = formatTime(audio.duration);
          });
        }

        if (progressContainer) {
          progressContainer.addEventListener("click", (e) => {
            const width = progressContainer.clientWidth;
            const clickX = e.offsetX;
            const duration = audio.duration;
            if (duration) {
              audio.currentTime = (clickX / width) * duration;
            }
          });
        }

        function formatTime(seconds) {
          if (isNaN(seconds)) return "00:00";
          const min = Math.floor(seconds / 60);
          const sec = Math.floor(seconds % 60);
          return `${min < 10 ? "0" : ""}${min}:${sec < 10 ? "0" : ""}${sec}`;
        }
      })();
    </script>

    <script is:inline>
      // // Loader
      const SHOW_LOADER = true;

      if (!SHOW_LOADER) {
        loader.style.display = "none";
        homepage.style.opacity = "1";

        window.dispatchEvent(new Event("facesInit"));
      } else {
        (function () {
          const loader = document.getElementById("loader");
          const loaderLogo = document.querySelector(".loader-logo");
          const homepage = document.getElementById("homepage");
          const body = document.body;
          let transitioned = false;
          let fallbackTimer = setTimeout(runTransition, 8000);

          const glitchLines = document.querySelectorAll(
            "#section-brand-story .theme-glitch-text",
          );
          const lineTop = glitchLines[0];
          const lineMid = glitchLines[1];
          const lineBottom = glitchLines[2];
          const subtitle = document.querySelector(
            "#section-brand-story .story-subtitle",
          );

          const videosTop = document.querySelectorAll(
            "#section-brand-story .vid1, #section-brand-story .vid2",
          );
          const videoMid = document.querySelectorAll(
            "#section-brand-story .vid3",
          );
          const videosBottom = document.querySelectorAll(
            "#section-brand-story .vid4, #section-brand-story .vid5",
          );

          document.documentElement.style.overflow = "hidden";

          const scrollY = window.scrollY || window.pageYOffset;
          const centerY = scrollY + window.innerHeight / 2;

          gsap.set(loader, {
            clipPath: "circle(150vmax at 50% 50vh)",
          });
          gsap.set(homepage, {
            clipPath: `circle(0vmax at 50% ${centerY}px)`,
            scale: 1.06,
          });
          gsap.set([lineTop, lineMid, lineBottom], {
            clipPath: "inset(0 100% 0 0)",
          });
          gsap.set(subtitle, {
            opacity: 0,
            y: 20,
          });
          gsap.set([videosTop, videoMid, videosBottom], {
            opacity: 0,
            scale: 0.94,
          });

          // SVG Logo Animation
          const outlinePaths = document.querySelectorAll(".logo-outline");
          const fillPaths = document.querySelectorAll(".logo-fill");

          outlinePaths.forEach((path) => {
            const length = path.getTotalLength();
            gsap.set(path, {
              strokeDasharray: length,
              strokeDashoffset: length,
            });
          });

          const logoTl = gsap.timeline({
            defaults: { ease: "power2.inOut" },
            onComplete: runTransition,
          });

          // 1. Draw outline
          logoTl.to(outlinePaths, {
            strokeDashoffset: 0,
            duration: 2.4,
            stagger: { each: 0.28 },
            ease: "power2.inOut",
          });

          // 2. Small cinematic pause
          logoTl.to({}, { duration: 0.18 });

          // 3. Solid fill appears
          logoTl.to(fillPaths, {
            opacity: 1,
            duration: 0.75,
            stagger: { each: 0.08 },
            ease: "power2.out",
          });

          // 4. Outline fades away
          logoTl.to(
            outlinePaths,
            {
              opacity: 0,
              duration: 0.45,
              ease: "power2.out",
            },
            "-=0.35",
          );

          function runTransition() {
            if (transitioned) return;
            transitioned = true;
            clearTimeout(fallbackTimer);

            body.classList.remove("is-loading");
            gsap.set(loader, {
              pointerEvents: "none",
            });

            const tl = gsap.timeline({
              onComplete: () => {
                document.documentElement.style.overflow = "";
                loader.style.display = "none";
                gsap.set(homepage, {
                  clipPath: "none",
                });
                // Loader animation done â€ initialize everything
                window.dispatchEvent(new Event("facesInit"));
                window.dispatchEvent(new Event("runrLoaderComplete"));
                ScrollTrigger.refresh();
              },
            });

            // 1. Logo shrinks into the center point and fades
            tl.to(
              loaderLogo,
              {
                scale: 0.5,
                opacity: 0,
                duration: 0.8,
                ease: "power2.in",
              },
              0,
            );

            // 2. Loader itself closes like a camera aperture, into that same point
            tl.to(
              loader,
              {
                clipPath: "circle(0vmax at 50% 50vh)",
                duration: 1.1,
                ease: "power4.inOut",
              },
              0.05,
            );

            // 3. Homepage opens outward from that exact point â€ the "lens
            // reopening on the new scene" moment that ties both halves together
            tl.to(
              homepage,
              {
                clipPath: `circle(150vmax at 50% ${centerY}px)`,
                scale: 1,
                duration: 1.3,
                ease: "power4.inOut",
              },
              0.75,
            );

            // 4. Hero wipes in, top to bottom, in sync with the aperture opening
            tl.to(
              videosTop,
              {
                opacity: 1,
                scale: 1,
                duration: 0.9,
                stagger: 0.08,
                ease: "expo.out",
              },
              1.05,
            )
              .to(
                lineTop,
                {
                  clipPath: "inset(0 0% 0 0)",
                  duration: 0.9,
                  ease: "power4.inOut",
                },
                1.08,
              )

              .to(
                videoMid,
                {
                  opacity: 1,
                  scale: 1,
                  duration: 0.9,
                  ease: "expo.out",
                },
                1.3,
              )
              .to(
                lineMid,
                {
                  clipPath: "inset(0 0% 0 0)",
                  duration: 0.9,
                  ease: "power4.inOut",
                },
                1.33,
              )

              .to(
                videosBottom,
                {
                  opacity: 1,
                  scale: 1,
                  duration: 0.9,
                  stagger: 0.08,
                  ease: "expo.out",
                },
                1.55,
              )
              .to(
                lineBottom,
                {
                  clipPath: "inset(0 0% 0 0)",
                  duration: 0.9,
                  ease: "power4.inOut",
                },
                1.58,
              )
              .to(
                subtitle,
                {
                  opacity: 1,
                  y: 0,
                  duration: 0.8,
                  ease: "expo.out",
                },
                1.8,
              );
          }
        })();
      }

      // Service Block Active State & Stacking Cards Effect
      if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
        gsap.registerPlugin(ScrollTrigger);

        var serviceBlocks = gsap.utils.toArray(".service-block");

        serviceBlocks.forEach(function (block, index) {
          var blackText = block.querySelector(".black");

          if (blackText) {
            gsap.to(blackText, {
              clipPath: "inset(0 0% 0 0)",
              ease: "none",
              scrollTrigger: {
                trigger: block,
                start: "top center",
                end: "bottom center",
                scrub: true,
              },
            });
          }

          // Card Stacking Scale Effect
          if (index < serviceBlocks.length - 1) {
            gsap.to(block, {
              scale: 0.92,
              opacity: 0.5,
              filter: "blur(5px)",
              ease: "none",
              scrollTrigger: {
                trigger: serviceBlocks[index + 1],
                start: "top bottom-=100",
                end: "top top+=140",
                scrub: true,
              },
            });
          }
        });
      }
    </script>

