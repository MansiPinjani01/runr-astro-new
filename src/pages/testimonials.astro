      </div>

    </div>
  </section><!-- TESTIMONIALS SCRIPTS -->
  

<Fragment slot="page-scripts">
<script is:inline>
    (function() {
      if (typeof gsap === 'undefined') return;
      gsap.registerPlugin(ScrollTrigger);

      /* Card reveal */
      document.querySelectorAll('.testimonials-card').forEach((card, i) => {
        const fromClip = (i % 2 === 0) ? 'inset(0 0 0 100%)' : 'inset(100% 0 0 0)';
        gsap.from(card, {
          clipPath: fromClip,
          duration: 0.9,
          ease: 'power4.inOut',
          scrollTrigger: {
            trigger: card,
            start: 'top 92%',
            toggleActions: 'play none none reverse'
          }
        });
      });

      /* 3D tilt on desktop */
      const isCoarse = window.matchMedia('(pointer:coarse)').matches;
      if (!isCoarse) {
        document.querySelectorAll('.testimonials-card').forEach(card => {
          const rotX = gsap.quickTo(card, 'rotationX', {
            duration: .5,
            ease: 'power3.out'
          });
          const rotY = gsap.quickTo(card, 'rotationY', {
            duration: .5,
            ease: 'power3.out'
          });
          card.addEventListener('mousemove', e => {
            const r = card.getBoundingClientRect();
            rotY(((e.clientX - r.left) / r.width - 0.5) * 8);
            rotX(((e.clientY - r.top) / r.height - 0.5) * -8);
          });
          card.addEventListener('mouseleave', () => {
            rotX(0);
            rotY(0);
          });
        });
      }

      ScrollTrigger.refresh();
    })();
  </script>
</Fragment>

</BaseLayout>
