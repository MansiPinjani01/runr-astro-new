<BaseLayout
  title="Testimonials - runr"
  page="testimonials"
  pagename="Testimonials"
  popup={true}
  onepagemenu={true}
>


  <section id="section-about-us" class="section section-about-us">
    <div class="theme-padding about-us-wrapper js-scroll fade-in-left scrolled">
      <div class="move-box"></div>
      <div class="section-title title-animate">
        <h1 class="text-xl text-uppercase">
          Trusted Voices. <br /><span class="theme-text text-uppercase"
            >Proven Impact.</span
          >
        </h1>
      </div>
      <div class="theme-content-block js-scroll fade-in-right scrolled">
        <div class="theme-content-title">
          <span>Testimonials</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="81"
            height="9"
            viewBox="0 0 81 9"
            fill="none"
          >
            <rect y="4" width="80" height="1" fill="#111013"></rect>
            <path
              d="M77 7.96366L80.5 4.48183L77 1"
              stroke="#111013"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <p>
          We don't just create experiences—we create relationships. Every
          testimonial reflects the trust, confidence, and lasting connections
          we've built with our clients, partners, and community.
        </p>
      </div>
    </div>
  </section>

  <section class="section testimonials-grid-section theme-padding">
    <div class="theme-color-shadow"></div>
    <div class="testimonials-masonry" id="testimonialsMasonry">
      {
        testimonials.map((item) =>
          item.type === "video" ? (
            <div class="testimonials-card testimonials-video">
              <a
                href={item.videoSrc}
                data-fancybox="testimonials-videos"
                data-caption={item.caption}
                class="testimonials-video-link"
                aria-label={`Play video: ${item.caption}`}
              >
                <picture class="testimonials-video-img">
                  <img src={item.thumbnail} alt={item.caption} />
                </picture>
                <div class="testimonials-play-btn">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="icon icon-tabler icons-tabler-filled icon-tabler-player-play"
                  >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M6 4v16a1 1 0 0 0 1.524 .852l13 -8a1 1 0 0 0 0 -1.704l-13 -8a1 1 0 0 0 -1.524 .852z" />
                  </svg>
                </div>
              </a>
              <div class="testimonials-video-body">
                <h3 set:html={item.name} />
              </div>
            </div>
          ) : (
            <div class="testimonials-card">
              <div class="testimonials-person">
                <picture class="testimonials-avatar">
                  <img src={item.avatar} alt={item.name} />
                </picture>
                <div class="testimonial-name">
                  <h3>{item.name}</h3>
                  <span>{item.designation}</span>
                </div>
              </div>
              <p class="testimonials-quote">{item.quote}</p>
            </div>
          ),
        )
      }
    </div>
  </section>

  <Fragment slot="page-scripts">
    <script is:inline>
      (function () {
        if (typeof gsap === "undefined") return;
        gsap.registerPlugin(ScrollTrigger);

        /* Card reveal */
        document.querySelectorAll(".testimonials-card").forEach((card, i) => {
          const fromClip =
            i % 2 === 0 ? "inset(0 0 0 100%)" : "inset(100% 0 0 0)";
          gsap.from(card, {
            clipPath: fromClip,
            duration: 0.9,
            ease: "power4.inOut",
            scrollTrigger: {
              trigger: card,
              start: "top 92%",
              toggleActions: "play none none reverse",
            },
          });
        });

        /* 3D tilt on desktop */
        const isCoarse = window.matchMedia("(pointer:coarse)").matches;
        if (!isCoarse) {
          document.querySelectorAll(".testimonials-card").forEach((card) => {
            const rotX = gsap.quickTo(card, "rotationX", {
              duration: 0.5,
              ease: "power3.out",
            });
            const rotY = gsap.quickTo(card, "rotationY", {
              duration: 0.5,
              ease: "power3.out",
            });
            card.addEventListener("mousemove", (e) => {
              const r = card.getBoundingClientRect();
              rotY(((e.clientX - r.left) / r.width - 0.5) * 8);
              rotX(((e.clientY - r.top) / r.height - 0.5) * -8);
            });
            card.addEventListener("mouseleave", () => {
              rotX(0);
              rotY(0);
            });
          });
        }

        ScrollTrigger.refresh();
      })();
    </script>
  </Fragment>
</BaseLayout>
