    type: "text",
    name: "Rahul Patel",
    designation: "Noida",
    //avatar:
      // "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=200&q=80",
    quote:
      "We had a very positive experience working with the team. The team understood our target audience and worked on improving the campaign based on the response. The lead generation campaign was handled in a structured manner, with regular updates on progress. The overall coordination was good, and support was available whenever we needed it.",
  },
];

// Auto-sort: 1 video → 3 text → repeat (maintains original layout pattern)
const videos = rawTestimonials.filter((t) => t.type === "video");
const texts = rawTestimonials.filter((t) => t.type === "text");
const testimonials: typeof rawTestimonials = [];
let vi = 0,
  ti = 0;
while (vi < videos.length || ti < texts.length) {
  if (vi < videos.length) testimonials.push(videos[vi++]);
  for (let j = 0; j < 3 && ti < texts.length; j++)
    testimonials.push(texts[ti++]);
}

const getInitials = (name: string) => {
  const parts = name.split(" ");
  if (parts.length >= 2) {
    return (parts[0][0] + parts[1][0]).toUpperCase();
  }
  return name.substring(0, 2).toUpperCase();
};
