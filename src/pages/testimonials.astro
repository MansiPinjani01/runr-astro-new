const videos = rawTestimonials.filter((t) => t.type === "video");
const texts = rawTestimonials.filter((t) => t.type === "text");
const testimonials: typeof rawTestimonials = [];
let vi = 0,
  ti = 0;
while (vi < videos.length || ti < texts.length) {
