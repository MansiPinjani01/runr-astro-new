          panelRefs.forEach((p) => {
            setEntranceHidden(p);
            ScrollTrigger.create({
              trigger: p.el,
              start: "top 78%",
              once: true,
              onEnter: () => playPanelContent(p),
            });
          });
        }

        function teardown() {
          if (currentST) {
            currentST.kill();
            currentST = null;
          }
          ScrollTrigger.getAll().forEach((t) => {
            if (
              t.vars.trigger === "#hwrap" ||
              (t.vars.trigger &&
                t.vars.trigger.classList &&
                t.vars.trigger.classList.contains("panel"))
