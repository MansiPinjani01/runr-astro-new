        const eyebrowDot = document.getElementById("eyebrowDot");

        if (!hTrack) return;

        function buildPanel(m) {
          const panel = document.createElement("div");
          panel.className = "panel";
          panel.setAttribute("data-year", m.year.toLowerCase());
          panel.innerHTML = `
            <div class="year">${m.year}</div>
            <div class="col-text">
              <div class="kicker">${m.kicker}</div>
              <h2>${m.heading}</h2>
              <p>${m.body}</p>
            </div>
            <div class="col-images">
              ${m.images.map((im, i) => `<div class="img ${im.isLogo ? "logo-card" : ""} ${im.isStory ? "story-card" : ""}" style="top:${im.top};left:${im.left};width:${im.width};height:${im.height};background-image:url(${im.src});--r:${i % 2 === 0 ? "-10deg" : "10deg"}"></div>`).join("")}
            </div>
          `;
          return panel;
        }

        const panelRefs = milestones.map((m) => {
          const el = buildPanel(m);
          hTrack.appendChild(el);
          return {
            el,
            year: el.querySelector(".year"),
            kicker: el.querySelector(".kicker"),
            heading: el.querySelector("h2"),
            body: el.querySelector("p"),
            images: [...el.querySelectorAll(".img")],
          };
        });

        const total = milestones.length;
        let currentST = null;

        function isDesktop() {
          return window.innerWidth > 768;
        }

        function setEntranceHidden(p) {
          gsap.set(p.year, { opacity: 0, x: -50, skewX: -8 });
          gsap.set(p.kicker, { opacity: 0, y: 22 });
          gsap.set(p.heading, { opacity: 0, y: 28 });
          gsap.set(p.body, { opacity: 0, y: 22 });
          p.images.forEach((imgEl) => imgEl.classList.remove("revealed"));
        }

        function playPanelContent(p) {
          const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
          tl.to(p.year, {
            opacity: 1,
            x: 0,
            skewX: 0,
            duration: 0.8,
            ease: "expo.out",
          })
            .to(p.kicker, { opacity: 1, y: 0, duration: 0.5 }, "-=.5")
            .to(p.heading, { opacity: 1, y: 0, duration: 0.55 }, "-=.4")
            .to(p.body, { opacity: 1, y: 0, duration: 0.5 }, "-=.35");

          p.images.forEach((imgEl, idx) => {
            setTimeout(() => imgEl.classList.add("revealed"), idx * 90 + 150);
          });

          return tl;
        }

        function playRailAndMarker() {
          const tl = gsap.timeline();
          tl.to(hRail, { scaleX: 1, duration: 0.9, ease: "power2.inOut" })
            .to(
              eyebrowDot,
              { scale: 1, duration: 0.4, ease: "back.out(3)" },
              "<",
            )
            .to(
              hMarker,
              { scale: 1, duration: 0.5, ease: "back.out(4)" },
              "-=.35",
            )
            .add(() => {
              eyebrowDot.classList.add("pulsing");
              hMarker.classList.add("pulsing");
            });
          return tl;
        }

        function setupDesktop() {
          gsap.set(hTrack, { xPercent: 0 });
          gsap.set(eyebrowDot, { scale: 1 });
          gsap.set(hMarker, { scale: 1 });
          gsap.set(hRail, { scaleX: 1 });
          eyebrowDot.classList.add("pulsing");
          hMarker.classList.add("pulsing");

          // Show first panel content by default (no blank state)
          panelRefs.forEach((p, i) => {
            if (i === 0) {
              gsap.set(p.year, { opacity: 1, x: 0, skewX: 0 });
              gsap.set(p.kicker, { opacity: 1, y: 0 });
              gsap.set(p.heading, { opacity: 1, y: 0 });
              gsap.set(p.body, { opacity: 1, y: 0 });
              p.images.forEach((imgEl) => imgEl.classList.add("revealed"));
            } else {
              setEntranceHidden(p);
            }
          });

          let activeIdx = 0;

          currentST = ScrollTrigger.create({
            trigger: "#hwrap",
            start: "top top",
            end: () => "+=" + window.innerWidth * (total - 1),
            pin: "#hViewport",
            scrub: 0.6,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              gsap.set(hTrack, {
                xPercent: -100 * (total - 1) * self.progress,
              });
              hMarker.style.left = `${self.progress * 100}%`;

              const idx = Math.min(
                total - 1,
                Math.max(0, Math.round(self.progress * (total - 1))),
              );
              if (idx !== activeIdx) {
                activeIdx = idx;
                setEntranceHidden(panelRefs[idx]);
                playPanelContent(panelRefs[idx]);
              }
            },
          });
        }

        function setupMobile() {
          gsap.set(hTrack, { xPercent: 0, clearProps: "transform" });
          gsap.set(hRail, { scaleX: 1 });
          gsap.set(hMarker, { scale: 1 });
