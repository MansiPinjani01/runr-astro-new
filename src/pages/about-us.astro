            width: "100%",
            height: "100%",
            borderRadius: "0px",
            ease: "power2.inOut",
            scrollTrigger: {
              trigger: "#section-runr-team",
              start: "top top",
              end: "bottom top",
              scrub: 1,
              pin: true,
              markers: false,
            },
          },
        );
