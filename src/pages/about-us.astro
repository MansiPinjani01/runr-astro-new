              t.kill();
            }
          });
          gsap.set(hTrack, { xPercent: 0, clearProps: "transform" });
        }

        let lastMode = null;
        function applyLayout(force) {
          const mode = isDesktop() ? "desktop" : "mobile";
          if (!force && mode === lastMode) {
            ScrollTrigger.refresh();
            return;
          }
          lastMode = mode;
          teardown();
          if (mode === "desktop") {
            setupDesktop();
          } else {
            setupMobile();
          }
          ScrollTrigger.refresh();
        }

        applyLayout(true);
        let resizeTimer;
        window.addEventListener("resize", () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => applyLayout(false), 200);
        });
      })();
    </script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        const content = document.querySelector(".op-new");
        if (!content) return;
        const media = content.querySelector(".op-new-img-group");
        const track = content.querySelector(".op-new-img-group-track");
        const slides = content.querySelectorAll(".op-new-img-group-slide");
        const highlight = content.querySelector(".op-highlight");
        const items = content.querySelectorAll(".op-new-item");
        let activeItem = null;
        let activeIndex = -1;

        function getSlideHeight() {
          return slides.length ? slides[0].offsetHeight : 0;
        }

        function moveHighlight(item) {
          highlight.style.transform = "translateY(" + item.offsetTop + "px)";
          highlight.style.height = item.offsetHeight + "px";
        }

        function moveMedia(item, index) {
          const top = item.offsetTop;
          const height = item.offsetHeight;
          const slideHeight = getSlideHeight();
          const imgHalfH = media.offsetHeight / 2;
          const containerH = content.offsetHeight;
          let centerY = top + height / 2;
          centerY = Math.max(
            imgHalfH,
            Math.min(containerH - imgHalfH, centerY),
          );
          media.style.transform =
            "translate(-50%, " + centerY + "px) translateY(-50%)";
          track.style.transform = "translateY(-" + index * slideHeight + "px)";
        }

        function setActiveItem(item, index) {
          activeItem = item;
          activeIndex = index;
          content.classList.add("is-hovering");
          items.forEach(function (el) {
            el.classList.toggle("is-active", el === item);
          });
          moveHighlight(item);
          moveMedia(item, index);
        }

        function clearActiveItem() {
          activeItem = null;
          activeIndex = -1;
          content.classList.remove("is-hovering");
          items.forEach(function (el) {
            el.classList.remove("is-active");
          });
          highlight.style.height = "0px";
          media.style.transform = "translate(-50%, 0) translateY(-50%)";
        }

        items.forEach(function (item, index) {
          item.addEventListener("mouseenter", function () {
            setActiveItem(item, index);
          });
        });

        content.addEventListener("mouseleave", clearActiveItem);

        window.addEventListener("resize", function () {
          if (activeItem && activeIndex > -1) {
            moveHighlight(activeItem);
            moveMedia(activeItem, activeIndex);
          }
        });
      });
    </script>
  </Fragment>
</BaseLayout>
