---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Us - runr"
  page="about-us"
  pagename="About Us"
  slider={true}
  swiperjs={true}
  counter={true}
  onepagemenu={true}
>
  <div class="video-bg">
    <video autoplay muted loop playsinline>
      <source src="/media/images/bg-video-white.mp4" type="video/mp4" />
    </video>
  </div>

  <section id="section-about-us" class="section section-about-us pb-0">
    <div class="theme-padding about-us-wrapper js-scroll fade-in-left scrolled">
      <div class="move-box"></div>
      <div class="section-title title-animate">
        <h1 class="text-xl text-uppercase">
          Create Together. <br /><span class="theme-text text-uppercase"
            >Grow Forever.</span
          >
        </h1>
      </div>
      <div class="theme-content-block js-scroll fade-in-right scrolled">
        <div class="theme-content-title">
          <span>About Us</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="81"
            height="9"
            viewBox="0 0 81 9"
            fill="none"
          >
            <rect y="4" width="80" height="1" fill="#111013"></rect>
            <path
              d="M77 7.96366L80.5 4.48183L77 1"
              stroke="#111013"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <p>
          We don't just follow trends”we create them. Every story we craft,
          every video we produce, and every campaign we launch is designed to
          give brands a stronger voice, lasting impact, and a moment that truly
          stands out.
        </p>
      </div>
    </div>
  </section>

  <section id="section-runr-team" class="section-runr-team pb-0">
    <div class="runr-team-img js-scroll fade-up">
      <video autoplay="" muted="" loop="" playsinline="">
        <source
          src="/media/images/about-us/runr-team/runr-video.mp4"
          type="video/mp4"
        />
      </video>
    </div>
  </section>

  <!-- Our Vision -->

  <section
    id="section-our-vision"
    class="section section-our-vision theme-padding"
  >
    <div class="theme-color-shadow"></div>
    <div class="columns is-multiline our-cols gap-1">
      <div
        class="column is-12-mobile is-12-tablet is-6-desktop is-6-widescreen our-col js-scroll fade-up"
      >
        <div class="our-vision-block">
          <div class="section-title title-animate">
            <span class="sub-title">Our</span>
            <h2 class="text-xl theme-text">Vision</h2>
          </div>
          <p>
            To become most dynamic and trusted content and influencer platform ”
            where brands, creators, and ideas come together to inspire, engage,
            and shape culture.
          </p>
        </div>
      </div>
      <div
        class="column is-12-mobile is-12-tablet is-6-desktop is-6-widescreen our-col js-scroll fade-up"
      >
        <div class="our-mission-block is-relative">
          <div class="section-title title-animate">
            <span class="sub-title">Our</span>
            <h2 class="text-xl theme-text">Mission</h2>
          </div>
          <p>
            At Runr, our mission is to empower brands through creative
            storytelling, influencer-driven marketing, and original content IPs.
          </p>
          <p>
            We aim to make digital communication more meaningful by producing
            high-impact reels, podcasts, music, and kid-centric content ” while
            simplifying technology for the everyday user through regional
            languages.
          </p>
        </div>
      </div>
    </div>
  </section>

