  <!-- Our Team -->

  <section class="team-section" id="section-creative-team">
    <div class="stage" id="stage">
      <svg
        class="lines"
        id="lines"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"></svg>
      <div class="center-stack">
        <div class="founder-anchor" id="founderAnchor">
          <div class="founder-photo-wrap-team">
            <div class="founder-ring" id="founderRing"></div>
            <img
              src="/media/images/about-us/runr-team/team-img1.webp"
              alt="Sagar Goswami"
            />
          </div>
          <div class="founder-caption">
            <div class="name">Sagar Goswami</div>
            <div class="role">Co-Founder & CEO</div>
          </div>
        </div>

        <div class="center-copy">
          <div class="section-title title-animate">
            <h2 class="text-md">
              Our <br />
              <span class="theme-text">Creative </span><br /> Team
            </h2>
          </div>
          <p class="center-desc">
            One vision, six creative minds — strategists, storytellers and
            creators who turn a single idea into work worth remembering.
          </p>
        </div>
      </div>

      <div id="slots"></div>
      <div class="tally" id="tally">
        <span class="dot"></span> Six creative minds — one studio
      </div>
    </div>

    <div class="mobile-feed" id="mobileFeed"></div>
  </section>

  <!-- Contact Team -->

  <section
    id="section-contact-team"
    class="section-contact-team pb-0 black-bg theme-padding"
  >
    <div class="columns is-mobile is-multiline is-vcentered contact-team-cols">
      <div
        class="column is-12-mobile is-12-tablet is-4-desktop is-4-widescreen contact-team-col"
      >
        <div class="section-title dark title-animate">
          <h2>Redy to Create <br /> Something <br />Extraordinary</h2>
        </div>
      </div>
      <div
        class="column is-12-mobile is-12-tablet is-5-desktop is-5-widescreen contact-team-col"
      >
        <div class="runr-team-img">
          <picture>
            <img
              src="/media/images/team-culture/runr-team.webp"
              alt="Runr Team"
            />
          </picture>
        </div>
      </div>
      <div
        class="column is-12-mobile is-12-tablet is-3-desktop is-3-widescreen contact-team-col"
      >
        <div class="team-contact-desc dark">
          <p>Let's build Something Iconic Togather</p>
          <a href="/contact-us/" class="theme-arrow-btn theme-btn btn-primary"
            >Let's Connect
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M5 12l14 0"></path>
              <path d="M15 16l4 -4"></path>
              <path d="M15 8l4 4"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder Section Animations -->

  <Fragment slot="page-scripts">
    <script is:inline>
      // Runr Team Image ” small to full-width on scroll
      if (window.matchMedia("(min-width: 769px)").matches) {
        gsap.fromTo(
          ".runr-team-img",
          {
            width: "50%",
            height: "50%",
            borderRadius: "30px",
          },
          {
            width: "100%",
            height: "100%",
            borderRadius: "0px",
            ease: "power2.inOut",
            scrollTrigger: {
              trigger: "#section-runr-team",
              start: "top top",
              end: "bottom top",
              scrub: 1,
              pin: true,
              markers: false,
            },
          },
        );
      } else {
        // Mobile/Tablet ” smaller expand range
        gsap.fromTo(
          ".runr-team-img",
          {
            width: "80%",
            borderRadius: "20px",
          },
          {
            width: "100%",
            borderRadius: "0px",
            ease: "power2.inOut",
            scrollTrigger: {
              trigger: "#section-runr-team",
              start: "top center",
              end: "top top",
              scrub: 1,
              markers: false,
            },
          },
        );
      }
    </script>
    <script is:inline>
      (function () {
        if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
          return;
        gsap.registerPlugin(ScrollTrigger);

        /* =========================================================
         DATA — Team members with multiple images per slot (waves)
      ========================================================= */
        var members = [
          {
            name: "Suhas Kalyan",
            role: "Growth Guru",
            src: "/media/images/about-us/runr-team/team-img2.webp",
          },
          {
            name: "Gurmeet Singh",
            role: "Growth Guru",
            src: "/media/images/about-us/runr-team/team-img3.webp",
          },
          {
            name: "Prashant Solanki",
            role: "Growth Guru",
            src: "/media/images/about-us/runr-team/team-img4.webp",
          },
          {
            name: "Nirvik Dobariya",
            role: "Social Impact",
            src: "/media/images/about-us/runr-team/team-img5.webp",
          },
          {
            name: "Roman Vegad",
            role: "Creative Crew",
            src: "/media/images/about-us/runr-team/team-img6.webp",
          },
          {
            name: "Harshil Rathod",
            role: "Creative Crew",
            src: "/media/images/about-us/runr-team/team-img7.webp",
          },
          {
            name: "Suhas Kalyan",
            role: "Growth Guru",
            src: "/media/images/about-us/runr-team/team-img8.webp",
          },
          {
            name: "Gurmeet Singh",
            role: "Growth Guru",
            src: "/media/images/about-us/runr-team/team-img9.webp",
          },
          {
            name: "Prashant Solanki",
            role: "Growth Guru",
            src: "/media/images/about-us/runr-team/team-img2.webp",
          },
          {
            name: "Nirvik Dobariya",
            role: "Social Impact",
            src: "/media/images/about-us/runr-team/team-img3.webp",
          },
          {
            name: "Roman Vegad",
            role: "Creative Crew",
            src: "/media/images/about-us/runr-team/team-img5.webp",
          },
          {
            name: "Harshil Rathod",
            role: "Creative Crew",
            src: "/media/images/about-us/runr-team/team-img6.webp",
          },
        ];

        /* 6 slots — 3 left, 3 right — pulled inward to avoid edge cuts */
        var slotPositions = [
          { cx: 12, cy: 12, dir: "left", w: 190, h: 240 },
          { cx: 22, cy: 42, dir: "left", w: 180, h: 210 },
          { cx: 12, cy: 72, dir: "left", w: 175, h: 200 },
          { cx: 88, cy: 12, dir: "right", w: 190, h: 240 },
          { cx: 78, cy: 42, dir: "right", w: 180, h: 210 },
          { cx: 88, cy: 72, dir: "right", w: 175, h: 200 },
        ];

        var SLOT_COUNT = slotPositions.length;

        /* Assign members to slots in waves (2 waves of 6) */
        var slotMembers = slotPositions.map(function (_, i) {
          var arr = [];
          for (var w = 0; w < 2; w++) {
            var idx = i + w * SLOT_COUNT;
            if (idx < members.length) arr.push(idx);
          }
          return arr;
        });
        var maxWaves = Math.max.apply(
          null,
          slotMembers.map(function (a) {
            return a.length;
          }),
        );

        var slotsEl = document.getElementById("slots");
        var linesSvg = document.getElementById("lines");
        var FX = 50,
          FY = 12;

        slotPositions.forEach(function (pos, i) {
          var slot = document.createElement("div");
          slot.className = "slot";
          slot.style.left = pos.cx + "%";
          slot.style.top = pos.cy + "%";
          slot.style.width = pos.w + "px";
          slot.style.height = pos.h + 45 + "px";
          slot.dataset.dir = pos.dir;

          var firstIdx = slotMembers[i][0];
          var firstMember = members[firstIdx];

          var layers = "";
          slotMembers[i].forEach(function (memberIdx, w) {
            var m = members[memberIdx];
            layers +=
              '<div class="frame-layer wave' +
              (w + 1) +
              '" data-wave="' +
              (w + 1) +
              '"><div class="frame"><img src="' +
              m.src +
              '" alt="' +
              m.name +
              '" width="' +
              pos.w +
              '" height="' +
              pos.h +
              '" loading="' +
              (i < 4 ? "eager" : "lazy") +
              '"></div></div>';
          });

          slot.innerHTML =
            '<div class="portrait-stack">' +
            layers +
            '</div><div class="cap"><div><div class="cap-name">' +
            firstMember.name +
            '</div><div class="cap-role">' +
            firstMember.role +
            "</div></div></div>";
          slotsEl.appendChild(slot);

          var path = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "path",
          );
          path.setAttribute(
            "d",
            "M" +
              FX +
              "," +
              FY +
              " L" +
              FX +
              "," +
              pos.cy +
              " L" +
              pos.cx +
              "," +
              pos.cy,
          );
          linesSvg.appendChild(path);

          var dot = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "circle",
          );
          dot.setAttribute("cx", pos.cx);
          dot.setAttribute("cy", pos.cy);
          dot.setAttribute("r", "0.35");
          dot.style.opacity = "0";
          linesSvg.appendChild(dot);
        });

        /* Mobile feed */
        var mobileFeed = document.getElementById("mobileFeed");
        var shapeCycle = ["w-tall", "w-square", "w-wide", "w-close"];
        var feedHTML = '<div class="feed-marker">Our Creative Team</div>';
        members.forEach(function (m, i) {
          var shapeClass = shapeCycle[i % shapeCycle.length];
          var alignClass = i % 2 === 1 ? "align-r" : "";
          feedHTML +=
            '<div class="feed-item ' +
            shapeClass +
            " " +
            alignClass +
            '"><div class="frame"><img src="' +
            m.src +
            '" alt="' +
            m.name +
            '" loading="lazy"></div><div class="cap"><div><div class="name">' +
            m.name +
            '</div><div class="role">' +
            m.role +
            "</div></div></div></div>";
        });
        mobileFeed.innerHTML = feedHTML;

        /* =========================================================
         ANIMATION — Desktop: pinned, scrubbed with wave swap
      ========================================================= */
        var mm = gsap.matchMedia();

        mm.add("(min-width: 821px)", function () {
          var paths = linesSvg.querySelectorAll("path");
          var dots = linesSvg.querySelectorAll("circle");
          gsap.set(paths, { strokeDasharray: 140, strokeDashoffset: 140 });
          gsap.set(".frame-layer", { opacity: 0 });
          gsap.set(".slot .cap", { opacity: 0 });
          gsap.set(".center-copy", { opacity: 0, y: 16 });
          gsap.set(".tally", { opacity: 0, y: 10 });
          gsap.set("#founderAnchor", { scale: 1.5 });
          gsap.set("#founderRing", { opacity: 0, scale: 1.15 });

          var dirOffset = { left: { x: -40, y: 0 }, right: { x: 40, y: 0 } };
          document.querySelectorAll(".slot").forEach(function (slot) {
            var d = dirOffset[slot.dataset.dir];
            gsap.set(slot.querySelectorAll(".frame-layer"), { x: d.x, y: d.y });
          });

          var tl = gsap.timeline({
            scrollTrigger: {
              trigger: "#section-creative-team",
              start: "top top",
              end: "+=300%",
              scrub: 1,
              pin: "#stage",
              anticipatePin: 1,
            },
          });

          /* Phase 1: Founder scales in + center copy appears */
          tl.to("#founderAnchor", { scale: 1, duration: 1, ease: "power2.out" })
            .to(
              "#founderRing",
              { opacity: 1, scale: 1, duration: 0.6, ease: "power2.out" },
              "<",
            )
            .to(
              ".center-copy",
              { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
              "-=.5",
            );

          /* Phase 2: Lines draw + first wave of members appear */
          tl.to(
            paths,
            {
              strokeDashoffset: 0,
              duration: 1,
              ease: "power2.inOut",
              stagger: 0.04,
            },
            "-=.2",
          ).to(dots, { opacity: 0.7, duration: 0.4, stagger: 0.04 }, "<");

          tl.to(
            ".slot .frame-layer.wave1",
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 1,
              ease: "power3.out",
              stagger: 0.07,
            },
            "-=.3",
          ).to(".slot .cap", { opacity: 1, duration: 0.8, stagger: 0.07 }, "<");

          tl.to({}, { duration: 0.5 });

          /* Phase 3: Wave swap — images change on scroll */
          for (var w = 2; w <= maxWaves; w++) {
            var label = "swap" + w;
            tl.addLabel(label);

            document.querySelectorAll(".slot").forEach(function (slot, i) {
              var arr = slotMembers[i];
              if (!arr[w - 1]) return;
              var prevLayer = slot.querySelector(".frame-layer.wave" + (w - 1));
              var nextLayer = slot.querySelector(".frame-layer.wave" + w);
              var capEl = slot.querySelector(".cap");
              var nextMember = members[arr[w - 1]];
              var dir = slot.dataset.dir;
              var off = i * 0.05;

              tl.to(
                prevLayer,
                {
                  opacity: 0,
                  x: dir === "left" ? 40 : -40,
                  duration: 0.7,
                  ease: "power2.inOut",
                },
                label + "+=" + off,
              )
                .fromTo(
                  nextLayer,
                  { opacity: 0, x: dir === "left" ? -40 : 40 },
                  { opacity: 1, x: 0, duration: 0.9, ease: "power3.out" },
                  label + "+=" + (off + 0.1),
                )
                .to(capEl, { opacity: 0, duration: 0.22 }, label + "+=" + off)
                .call(
                  function (nm, nr, cel) {
                    cel.querySelector(".cap-name").textContent = nm;
                    cel.querySelector(".cap-role").textContent = nr;
                  },
                  [nextMember.name, nextMember.role, capEl],
                  label + "+=" + (off + 0.32),
                )
                .to(
                  capEl,
                  { opacity: 1, duration: 0.3 },
                  label + "+=" + (off + 0.42),
                )
                .to(
                  paths[i],
                  { stroke: "#F58220", opacity: 0.5, duration: 0.3 },
                  label + "+=" + off,
                )
                .to(
                  paths[i],
                  { opacity: 0.16, stroke: "#0B0B0A", duration: 0.5 },
                  label + "+=" + (off + 0.5),
                );
            });

            tl.to({}, { duration: 0.35 });
          }

          /* Phase 4: Tally appears at end */
          tl.to(
            ".tally",
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
            "-=.1",
          ).to("#stage", { duration: 0.5 });

          return function () {};
        });

        mm.add("(max-width: 820px)", function () {
          gsap.from(".center-stack", {
            opacity: 0,
            y: 20,
            duration: 0.8,
            ease: "power2.out",
            scrollTrigger: { trigger: ".center-stack", start: "top 88%" },
          });
          gsap.utils.toArray(".feed-item").forEach(function (el) {
            gsap.from(el, {
              opacity: 0,
              y: 34,
              duration: 0.8,
              ease: "power2.out",
              scrollTrigger: { trigger: el, start: "top 90%" },
            });
          });
        });
      })();
    </script>
    <script is:inline>
      (function () {
        if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
          return;
        gsap.registerPlugin(ScrollTrigger);

        var founderSection = document.querySelector(".section-founder-hero");
        if (!founderSection) return;

        var quoteText = founderSection.querySelector(
          ".founder-quote .quote-text",
        );
        if (quoteText) {
          gsap.fromTo(
            quoteText,
            { "--fill": "0%" },
            {
              "--fill": "100%",
              ease: "none",
              scrollTrigger: {
                trigger: quoteText,
                start: "top 85%",
                end: "top 40%",
                scrub: 1,
              },
            },
          );
        }

        var counters = founderSection.querySelectorAll(".about-company-col");
        if (counters.length) {
          gsap.fromTo(
            counters,
            { y: 30, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.6,
              stagger: 0.1,
              ease: "power3.out",
              scrollTrigger: {
                trigger: ".counter-block-wrapper",
                start: "top 85%",
                once: true,
              },
            },
          );
        }

        var photo = founderSection.querySelector(".founder-photo img");
        if (photo) {
          gsap.set(photo, { scale: 1.3, opacity: 0 });
          ScrollTrigger.create({
            trigger: founderSection,
            start: "top 50%",
            once: true,
            onEnter: function () {
              gsap.to(photo, {
                scale: 1,
                opacity: 1,
                duration: 1.2,
                ease: "power3.out",
              });
            },
          });
        }

        var name = founderSection.querySelector(".founder-name");
        if (name) {
          gsap.set(name, {
            letterSpacing: "15px",
            opacity: 0,
            filter: "blur(4px)",
          });
          ScrollTrigger.create({
            trigger: founderSection,
            start: "top 50%",
            once: true,
            onEnter: function () {
              gsap.to(name, {
                letterSpacing: "0px",
                opacity: 1,
                filter: "blur(0px)",
                duration: 1,
                delay: 0.3,
                ease: "power2.out",
              });
            },
          });
        }
      })();
    </script>
  </Fragment>
</BaseLayout>
