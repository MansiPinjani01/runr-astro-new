  <Fragment slot="page-scripts">
    <script is:inline>
      // Init Atithi slider (first tab, visible by default)
      var navSlider = new Swiper("#atithi", {
        effect: "coverflow",
        grabCursor: true,
        centeredSlides: true,
        loop: true,
        slidesPerView: 1.6,
        coverflowEffect: {
          rotate: 0,
          stretch: 0,
          depth: 150,
          modifier: 1.5,
          slideShadows: false,
        },
        keyboard: {
          enabled: true,
        },
        mousewheel: {
          thresholdDelta: 70,
        },
        initialSlide: 0,
        on: {
          click(event) {
            navSlider.slideTo(this.clickedIndex);
          },
        },
        navigation: {
          nextEl: "#tab1 .swiper-button-next",
          prevEl: "#tab1 .swiper-button-prev",
        },
        breakpoints: {
          1024: {
            slidesPerView: 1.6,
          },
          575: {
            slidesPerView: 1.3,
          },
          320: {
            slidesPerView: 1,
          },
        },
      });

      // Init other category sliders when their tab is shown
      var categorySliders = {};
      function initCategorySlider(tabId) {
        if (tabId === "tab1") return; // Atithi already initialized
        var sliderEl = document.querySelector("#" + tabId + " .swiper");
        if (!sliderEl || categorySliders[tabId]) return;
        categorySliders[tabId] = new Swiper(sliderEl, {
          effect: "coverflow",
          grabCursor: true,
          centeredSlides: true,
          loop: true,
          slidesPerView: 1.6,
          coverflowEffect: {
            rotate: 0,
            stretch: 0,
            depth: 150,
            modifier: 1.5,
            slideShadows: false,
          },
          keyboard: { enabled: true },
          mousewheel: { thresholdDelta: 70 },
          initialSlide: 0,
          on: {
            click(event) {
              categorySliders[tabId].slideTo(this.clickedIndex);
            },
          },
          navigation: {
            nextEl: "#" + tabId + " .swiper-button-next",
            prevEl: "#" + tabId + " .swiper-button-prev",
          },
          breakpoints: {
            1024: { slidesPerView: 1.6 },
            575: { slidesPerView: 1.3 },
            320: { slidesPerView: 1 },
          },
        });
      }

      // All Episodes Slider
      var allEpisodesSlider = new Swiper("#allEpisodesSlider", {
        slidesPerView: 5,
        spaceBetween: 20,
        centeredSlides: false,
        loop: true,
        grabCursor: true,
        navigation: {
          nextEl: ".ae-next-btn",
          prevEl: ".ae-prev-btn",
        },
        breakpoints: {
          0: {
            slidesPerView: 1,
            spaceBetween: 10,
          },
          480: {
            slidesPerView: 1.5,
            spaceBetween: 12,
          },
          768: {
            slidesPerView: 2.5,
            spaceBetween: 15,
          },
          1216: {
            slidesPerView: 4,
            spaceBetween: 20,
          },
          1599: {
            slidesPerView: 5,
            spaceBetween: 20,
          },
        },
      });

      // Browse By Series Slider
      var browseSeriesSlider = new Swiper("#browseSeriesSlider", {
        slidesPerView: 5,
        spaceBetween: 20,
        loop: true,
        grabCursor: true,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        breakpoints: {
          0: { slidesPerView: 1.5, spaceBetween: 10 },
          480: { slidesPerView: 2, spaceBetween: 12 },
          768: { slidesPerView: 3, spaceBetween: 15 },
          1024: { slidesPerView: 4, spaceBetween: 18 },
          1400: { slidesPerView: 5, spaceBetween: 20 },
        },
      });

      // Fancybox for podcast videos
      if (typeof Fancybox !== "undefined") {
        Fancybox.bind('[data-fancybox="atithi"]', {
          Toolbar: { display: ["close"] },
          Html: { video: { autoplay: true } },
        });
        Fancybox.bind('[data-fancybox="nav-narayani"]', {
          Toolbar: { display: ["close"] },
          Html: { video: { autoplay: true } },
        });
        Fancybox.bind('[data-fancybox="change-makers"]', {
          Toolbar: { display: ["close"] },
          Html: { video: { autoplay: true } },
        });
        Fancybox.bind('[data-fancybox="sahitya-safar"]', {
          Toolbar: { display: ["close"] },
          Html: { video: { autoplay: true } },
        });
        Fancybox.bind('[data-fancybox="swasthya-story"]', {
          Toolbar: { display: ["close"] },
          Html: { video: { autoplay: true } },
        });
      }

      // Tab Switching Function
      function openTab(evt, tabName, sectionClass) {
        var i, x, tablinks;
        var sections = document.querySelectorAll("." + sectionClass);
        sections.forEach(function (section) {
          x = section.querySelectorAll(".content-tab");
          for (i = 0; i < x.length; i++) {
            x[i].style.display = "none";
          }
          tablinks = section.querySelectorAll(".tab");
          for (i = 0; i < tablinks.length; i++) {
            tablinks[i].classList.remove("is-active");
          }
          var selectedTab = section.querySelector("#" + tabName);
          if (selectedTab) {
            selectedTab.style.display = "block";
          }
          evt.currentTarget.classList.add("is-active");
        });
        // Init the podcast slider for this tab if not already done
        if (typeof initCategorySlider === "function") {
          setTimeout(function () {
            initCategorySlider(tabName);
          }, 100);
        }
      }

      // Podcast Audio Waveform Animation
      (function () {
        var waveContainers = document.querySelectorAll("#wave");
        if (!waveContainers.length) return;
        var total = 40;
        var animationFrame;
        var t = 0;
        var allElements = [];

        waveContainers.forEach(function(wave) {
          var elements = [];
          for (var i = 0; i < total; i++) {
            var isDot = i % 6 === 0;
            var el = document.createElement("div");
            el.className = isDot ? "wave-dot" : "wave-bar";
            if (!isDot) {
              el.style.height = "8px";
            }
            wave.appendChild(el);
            elements.push({ el: el, isDot: isDot });
          }
          allElements.push(elements);
        });

        function randomHeight(index) {
          var centerDist = Math.abs(index - total / 2) / (total / 2);
          var base = 1 - centerDist * 0.7;
          var noise = Math.sin(t * 0.15 + index * 0.5) * 0.5 + 0.5;
          var rand = Math.random() * 0.3;
          return Math.max(6, base * 70 * (noise * 0.6 + rand + 0.2));
        }

        var frameCount = 0;
        function animate() {
          frameCount++;
          if (frameCount % 4 === 0) {
            t++;
            allElements.forEach(function(elements) {
              elements.forEach(function (item, i) {
                if (!item.isDot) {
                  var h = randomHeight(i);
                  item.el.style.height = h + "px";
                } else {
                  var scale = 1 + Math.sin(t * 0.1 + i) * 0.3;
                  item.el.style.transform = "scale(" + scale + ")";
                }
              });
            });
          }
          animationFrame = requestAnimationFrame(animate);
        }

        animate();
      })();

      // Subscriber Waveform Animation
      (function () {
        var wf = document.getElementById("subscriberWaveform");
        if (!wf) return;
        var heights = [
          8, 14, 22, 34, 44, 30, 18, 26, 40, 44, 28, 16, 10, 20, 32, 44, 26, 14,
          8, 18, 30, 38, 22, 12,
        ];
        heights.forEach(function (h) {
          var bar = document.createElement("span");
          bar.style.height = h + "px";
          wf.appendChild(bar);
        });

        var t = 0;
        function animateWave() {
          t++;
          if (t % 4 === 0) {
            var bars = wf.querySelectorAll("span");
            bars.forEach(function (bar, i) {
              var scale = 0.3 + Math.random() * 0.7;
              bar.style.transform = "scaleY(" + scale + ")";
            });
          }
          requestAnimationFrame(animateWave);
        }
        animateWave();
      })();
    </script>
  </Fragment>

