---
/*
  podcast.astro - Podcast Page
  Converted from PHP: index.php
  All PHP variables replaced with static paths.
  HTML structure preserved exactly as original.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Podcast - runr"
  page="podcast"
  pagename="Podcast"
  swiperjs={true}
  onepagemenu={true}
>

<div class="video-bg">
        <video autoplay muted loop playsinline>
            <source src="/media/images/bg-video-white.mp4" type="video/mp4">
        </video>
    </div>


    <section id="section-about-us" class="section section-about-us">
        <div class="theme-padding about-us-wrapper js-scroll fade-in-left scrolled">
            <div class="move-box"></div>
            <div class="theme-content-title mb-4">
                <span>Runr Spotlight</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="81" height="9" viewBox="0 0 81 9" fill="none">
                    <rect y="4" width="80" height="1" fill="#111013"></rect>
                    <path d="M77 7.96366L80.5 4.48183L77 1" stroke="#111013" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </div>
            <div class="section-title title-animate">
                <h1 class="text-xl text-uppercase">Every Voice. <br><span class="theme-text text-uppercase">Every Story.</span></h1>
            </div>
            <div class="theme-content-block js-scroll fade-in-right scrolled">
                <p>Explore the best moments from Runr Originals, transformed into engaging reels and shorts. Every conversation delivers fresh perspectives, inspiring stories, and content designed to connect with every audience.</p>
            </div>
        </div>
    </section>

    <section id="section-studio-img" class="section section-studio-img p-0">
        <div class="studio-img-block img-reveal-shutter">
            <picture>
                <img src="/media/images/home/spotlight/studio.webp" alt="Studio" width="1920" height="1080">
            </picture>
        </div>
    </section>

    <section id="section-podcast" class="section section-podcast position-sticky-section">
        <div class="theme-padding">
            <div class="columns is-multiline podcast-cols position-sticky-cols gap-1">
                <div class="column is-12-mobile is-12-tablet is-4-desktop is-3-widescreen podcast-col top-sticky js-scroll fade-in-left scrolled">
                    <div class="pillars-sidebar">
                        <div class="pillars-title">
                            <span class="theme-text">â—</span> <span class="text-uppercase fw-700">Our Pillars</span>
                        </div>
                        <div class="pillars-timeline">
                            <div class="pillar-item">
                                <div class="pillar-icon">
                                    <img src="/media/images/home/spotlight/nav-narayani.svg" alt="Nav Narayani" width="40" height="40">
                                </div>
                                <div class="pillar-info">
                                    <h4 class="pillar-name">Nav Narayani</h4>
                                    <p class="pillar-sub">Digital Network</p>
                                </div>
                            </div>
                            <div class="pillar-item">
                                <div class="pillar-icon">
                                    <img src="/media/images/home/spotlight/change-maker.svg" alt="Cherish Mehta" width="40" height="40">
                                </div>
                                <div class="pillar-info">
                                    <h4 class="pillar-name">Cherish Mehta</h4>
                                    <p class="pillar-sub">Motivational Speaker</p>
                                </div>
                            </div>
                            <div class="pillar-item">
                                <div class="pillar-icon">
                                    <img src="/media/images/home/spotlight/safar.svg" alt="Runr Ventures" width="40" height="40">
                                </div>
                                <div class="pillar-info">
                                    <h4 class="pillar-name">Runr Ventures</h4>
                                    <p class="pillar-sub">Building the Future</p>
                                </div>
                            </div>
                            <div class="pillar-item">
                                <div class="pillar-icon">
                                    <img src="/media/images/home/spotlight/swasth.svg" alt="Runr Creative Campus" width="40" height="40">
                                </div>
                                <div class="pillar-info">
                                    <h4 class="pillar-name">Runr Creative Campus</h4>
                                    <p class="pillar-sub">Learning to Lead</p>
                                </div>
                            </div>
                            <div class="pillar-item">
                                <div class="pillar-icon">
                                    <img src="/media/images/home/spotlight/atithi.svg" alt="Runr Foundation" width="40" height="40">
                                </div>
                                <div class="pillar-info">
                                    <h4 class="pillar-name">Runr Foundation</h4>
                                    <p class="pillar-sub">Impacting Communities</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="column is-12-mobile is-12-tablet is-8-desktop is-9-widescreen podcast-col js-scroll fade-in-right scrolled">
                    <div class="podcast-wrapper">
                        <div class="podcast-detail-wrapper">

                            <div class="podcast-deatil">
                                <div class="podcast-content">
                                    <p>We live at the intersection of media, impact and purpose. From high-impact digital properties and original storytelling to community-driven initiatives and creator-led ventures ” every vertical under RUNR is built to inform, entertain and empower.</p>
                                </div>
                                <div class="podcast-service-list">
                                    <h3 class="fw-600 mb-4 theme-text">Explore the pillars of our ecosystem:</h3>
                                    <a href="javascript:void(0)" class="podcast-service-item">
                                        <span class="ps-name">NavGujrati ” Informing You, Empowering All</span>
                                        <span class="ps-arrow">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M17 7l-10 10" />
                                                <path d="M8 7l9 0l0 9" />
                                            </svg>
                                        </span>
                                    </a>
                                    <a href="javascript:void(0)" class="podcast-service-item">
                                        <span class="ps-name">Cherish Mehta ” Transforming Lives</span>
                                        <span class="ps-arrow">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M17 7l-10 10" />
                                                <path d="M8 7l9 0l0 9" />
                                            </svg>
                                        </span>
                                    </a>
                                    <a href="javascript:void(0)" class="podcast-service-item">
                                        <span class="ps-name">Runr Ventures ” Building the Future</span>
                                        <span class="ps-arrow">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M17 7l-10 10" />
                                                <path d="M8 7l9 0l0 9" />
                                            </svg>
                                        </span>
                                    </a>
                                    <a href="javascript:void(0)" class="podcast-service-item">
                                        <span class="ps-name">Runr Creative Campus ” Learning to Lead</span>
                                        <span class="ps-arrow">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M17 7l-10 10" />
                                                <path d="M8 7l9 0l0 9" />
                                            </svg>
                                        </span>
                                    </a>
                                    <a href="javascript:void(0)" class="podcast-service-item">
                                        <span class="ps-name">Runr Foundation ” Impacting Communities</span>
                                        <span class="ps-arrow">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right">
                                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                                <path d="M17 7l-10 10" />
                                                <path d="M8 7l9 0l0 9" />
                                            </svg>
                                        </span>
                                    </a>
                                </div>
                            </div>
                            <div class="podcast-mic-video">
                                <video autoplay="" muted="" loop="" playsinline="">
                                    <source src="/media/images/home/spotlight/mic-with-wave.mp4" type="video/mp4">
                                </video>
                            </div>
                        </div>
                        <!-- Featured Highlights Slider -->
                        <div class="podcast-highlights-block">
                            <div class="highlights-header">
                                <h4><span class="theme-text">â—</span> Featured Highlights</h4>
                                <a href="javascript:void(0)" class="view-all-link">View all <span>&rarr;</span></a>
                            </div>
                            <div class="swiper podcast-highlights-slider">
                                <div class="swiper-wrapper">
                                    <div class="swiper-slide">
                                        <div class="highlight-card">
                                            <picture>
                                                <img src="/media/images/home/spotlight/nav-narayani.webp" alt="Nav Narayani" width="600" height="600">
                                            </picture>
                                            <a href="javascript:void(0)" class="highlight-play">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="swiper-slide">
                                        <div class="highlight-card">
                                            <picture>
                                                <img src="/media/images/home/spotlight/nav-narayani.webp" alt="Nav Narayani" width="600" height="600">
                                            </picture>
                                            <a href="javascript:void(0)" class="highlight-play">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="swiper-slide">
                                        <div class="highlight-card">
                                            <picture>
                                                <img src="/media/images/home/spotlight/nav-narayani.webp" alt="Nav Narayani" width="600" height="600">
                                            </picture>
                                            <a href="javascript:void(0)" class="highlight-play">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="swiper-slide">
                                        <div class="highlight-card">
                                            <picture>
                                                <img src="/media/images/home/spotlight/nav-narayani.webp" alt="Nav Narayani" width="600" height="600">
                                            </picture>
                                            <a href="javascript:void(0)" class="highlight-play">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

<Fragment slot="page-scripts">
<script is:inline>
      var podcastSlider = new Swiper('.podcast-highlights-slider', {
        slidesPerView: 3,
        spaceBetween: 15,
        grabCursor: true,
        breakpoints: {
          0: { slidesPerView: 1.2, spaceBetween: 10 },
          768: { slidesPerView: 2, spaceBetween: 12 },
          1024: { slidesPerView: 3, spaceBetween: 15 }
        }
      });
    </script>
</Fragment>

</BaseLayout>
