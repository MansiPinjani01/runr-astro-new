                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M9 6l6 6l-6 6"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Episodes Slider -->
      <div class="swiper all-episodes-slider js-scroll fade-in-bottom scrolled" id="allEpisodesSlider">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="ae-episode-card">
              <div class="ae-episode-img">
                <picture
                  ><img
                    src="/media/images/home/spotlight/all-episod/thumb-small-1.webp"
