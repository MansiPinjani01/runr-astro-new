  <!-- Why You Should Listen -->
  <section id="section-why-listen" class="section section-why-listen">
    <div class="theme-color-shadow"></div>

    <div class="theme-padding">
      <div
        class="section-title title-animate has-text-centered js-scroll fade-in-top scrolled"
      >
        <span class="sub-title">Why You Should Listen</span>
      </div>
      <div
        class="columns is-mobile is-multiline why-listen-cols js-scroll fade-in-bottom scrolled"
      >
        <div
          class="column is-6-mobile is-4-tablet is-4-desktop is-one-fifth-widescreen why-listen-col"
        >
          <div class="why-listen-item">
            <div class="why-listen-icon">
              <img
                src="/media/images/home/spotlight/people.webp"
                alt="Diverse Voices"
                width="60"
                height="60"
              />
            </div>
            <h4 class="text-uppercase">Diverse Voices</h4>
            <p>Conversations that bring different perspectives together.</p>
          </div>
        </div>
        <div
          class="column is-6-mobile is-4-tablet is-4-desktop is-one-fifth-widescreen why-listen-col"
        >
          <div class="why-listen-item">
            <div class="why-listen-icon">
              <img
                src="/media/images/home/spotlight/lightbulb.webp"
                alt="Meaningful Stories"
                width="60"
                height="60"
              />
            </div>
            <h4 class="text-uppercase">Meaningful Stories</h4>
            <p>Real stories that inspire and spark change, told at the length they deserve.</p>
          </div>
        </div>
        <div
          class="column is-6-mobile is-4-tablet is-4-desktop is-one-fifth-widescreen why-listen-col"
        >
          <div class="why-listen-item">
            <div class="why-listen-icon">
              <img
                src="/media/images/home/spotlight/mission.webp"
                alt="Community First"
                width="60"
                height="60"
              />
            </div>
            <h4 class="text-uppercase">Community First</h4>
            <p>Built to amplify voices from the community, not to amplify Runr.</p>
          </div>
        </div>
        <div
          class="column is-6-mobile is-4-tablet is-4-desktop is-one-fifth-widescreen why-listen-col"
        >
          <div class="why-listen-item">
            <div class="why-listen-icon">
              <img
                src="/media/images/home/spotlight/bar-chart.webp"
                alt="Impact Driven"
                width="60"
                height="60"
              />
            </div>
            <h4 class="text-uppercase">Impact Driven</h4>
            <p>Ideas meant to create action, not just engagement metrics.</p>
          </div>
