---
/*
  podcast.astro - Podcast Page
  Converted from PHP: index.php
  All PHP variables replaced with static paths.
  HTML structure preserved exactly as original.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import podcastData from "../data/podcast-categories.json";

const categories = podcastData.categories;
---

<BaseLayout
  title="Runr Podcasts — Real Conversations on Voices, Culture & Wellness"
  description="Runr Podcasts brings five original shows — from women's stories to folk culture and wellness — real conversations, bold perspectives, made by Runr."
  keywords="podcast production company India, original podcast network India, women empowerment podcast, folk culture podcast"
  canonical="https://www.runr.in/podcast/"
  page="podcast"
  pagename="Podcast"
  swiperjs={true}
  counter={true}
  onepagemenu={true}
>
  <script type="application/ld+json" slot="head" is:inline>{`
    {
      "@context": "https://schema.org",
      "@type": "PodcastSeries",
      "name": "Nav Narayani",
      "description": "Conversations with women who are building, leading, and changing what's possible — produced by Runr.",
      "publisher": {
        "@type": "Organization",
        "name": "Runr"
      }
    }
  `}</script>
  <section id="section-about-us" class="section section-about-us">
    <div class="theme-padding about-us-wrapper js-scroll fade-in-left scrolled">
      <div class="move-box"></div>
      <div class="section-title title-animate">
        <h1 class="text-xl text-uppercase">
          Every Voice. <br /><span class="theme-text text-uppercase"
            >Every Story.</span
          >
        </h1>
      </div>
      <div class="theme-content-block js-scroll fade-in-right scrolled">
        <div class="theme-content-title">
          <span>Runr Spotlight</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="81"
            height="9"
            viewBox="0 0 81 9"
            fill="none"
          >
            <rect y="4" width="80" height="1" fill="#111013"></rect>
            <path
              d="M77 7.96366L80.5 4.48183L77 1"
              stroke="#111013"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <p>
         Explore the best moments from Runr Originals, turned into reels and shorts worth sharing. Every conversation here is unscripted on purpose — real people, real perspectives, the kind of content that's genuinely hard to fake with a template or a script generator.
        </p>
      </div>
    </div>
  </section>

  <section id="section-studio-img" class="section section-studio-img p-0">
    <div class="studio-img-block img-reveal-shutter">
      <picture>
        <img
          src="/media/images/home/spotlight/studio.webp"
          alt="Studio"
          width="1920"
          height="1080"
        />
      </picture>
    </div>
  </section>

  <section
    id="section-podcast"
    class="section section-podcast position-sticky-section section1"
  >
    <div class="theme-padding js-scroll fade-in-bottom scrolled">
      <div class="columns is-multiline podcast-cols position-sticky-cols gap-1">
        <div
          class="column is-12-mobile is-12-tablet is-4-desktop is-3-widescreen top-sticky podcast-col"
        >
        <div class="is-hidden-desktop">
        <div class="podcast-title section-title title-animate">
            <div class="pillars-title">
              <span class="text-uppercase fw-700">Podcasts by runr</span>
            </div>
            <div class="podcast-content">
              <h1>
                Real <span class="theme-text">Conversations. <br /></span> Bold <span
                  class="theme-text">perspectives. <br /></span
                > Lasting Impact.
              </h1>
              <div class="wave-container is-justify-content-start" id="wave">
              </div>
            </div>
          </div>
          <div class="podcast-desc mb-5">
            <p>
              Exploring ideas, inspiring change and empowering communities <br
              />
              through stories that truly matter.
            </p>
          </div>
        </div>
          <div class="pillars-sidebar">
            <div class="pillars-title">
              <span class="text-uppercase fw-700">Our Podcast</span>
            </div>
            <div class="pillars-timeline">
              <a
                class="pillar-item tab is-active"
                onclick="openTab(event,'tab1', 'section1')"
              >
                <div class="pillar-icon">
                  <img
                    src="/media/images/home/spotlight/atithi.svg"
                    alt="Runr Foundation"
                    width="40"
                    height="40"
                  />
                </div>
                <div class="pillar-info">
                  <h4 class="pillar-name">Atithi</h4>
                  <p class="pillar-sub">Local Voices</p>
                </div>
              </a>
              <a
                class="pillar-item tab"
                onclick="openTab(event,'tab2', 'section1')"
              >
                <div class="pillar-icon">
                  <img
                    src="/media/images/home/spotlight/nav-narayani.svg"
                    alt="Nav Narayani"
                    width="40"
                    height="40"
                  />
                </div>
                <div class="pillar-info">
                  <h4 class="pillar-name">Nav Narayani</h4>
                  <p class="pillar-sub">Women Empowerment</p>
                </div>
              </a>
              <a
                class="pillar-item tab"
                onclick="openTab(event,'tab3', 'section1')"
              >
                <div class="pillar-icon">
                  <img
                    src="/media/images/home/spotlight/change-maker.svg"
                    alt="Cherish Mehta"
                    width="40"
                    height="40"
                  />
                </div>
                <div class="pillar-info">
                  <h4 class="pillar-name">Change Makers</h4>
                  <p class="pillar-sub">Life Lessons</p>
                </div>
              </a>
              <a
                class="pillar-item tab"
                onclick="openTab(event,'tab4', 'section1')"
              >
                <div class="pillar-icon">
                  <img
                    src="/media/images/home/spotlight/safar.svg"
                    alt="Runr Ventures"
                    width="40"
                    height="40"
                  />
                </div>
                <div class="pillar-info">
                  <h4 class="pillar-name">Sahitya Safar</h4>
                  <p class="pillar-sub">Folk Culture</p>
                </div>
              </a>
              <a
                class="pillar-item tab"
                onclick="openTab(event,'tab5', 'section1')"
              >
                <div class="pillar-icon">
                  <img
                    src="/media/images/home/spotlight/swasth.svg"
                    alt="Runr Creative Campus"
                    width="40"
                    height="40"
                  />
                </div>
                <div class="pillar-info">
                  <h4 class="pillar-name">Swasthya Story</h4>
                  <p class="pillar-sub">Wellness Wisdom</p>
                </div>
              </a>
            </div>
          </div>
        </div>
        <div
          class="column is-12-mobile is-12-tablet is-8-desktop is-9-widescreen podcast-col"
        >
          <div class="podcast-title section-title title-animate is-hidden-mobile">
            <div class="pillars-title">
              <span class="text-uppercase fw-700">Podcasts by runr</span>
            </div>
            <div class="podcast-content">
              <h1>
                Real <span class="theme-text">Conversations. <br /></span> Bold <span
                  class="theme-text">perspectives. <br /></span
                > Lasting Impact.
              </h1>
              <div class="wave-container is-justify-content-start" id="wave">
              </div>
            </div>
          </div>
          <div class="podcast-desc mb-5 is-hidden-mobile">
            <p>
              Exploring ideas, inspiring change and empowering communities <br
              />
              through stories that truly matter.
            </p>
          </div>
          <div class="tab-content">
            {
              categories.map((cat, catIdx) => (
                <div
                  class="content-tab"
                  id={cat.id}
                  style={catIdx === 0 ? "display:block" : "display:none"}
                >
                  <div class="podcast-player-block">
                    <div
                      id={catIdx === 0 ? "atithi" : `podcast-slider-${cat.id}`}
                      class="swiper"
                    >
                      <div class="swiper-wrapper">
                        {cat.slides.map((slide) => (
                          <div class="swiper-slide">
                            <div class="podcast-slide-card">
                              <div class="podcast-slide-img">
                                <picture>
                                  <img
                                    src={slide.thumb}
                                    alt={slide.alt}
                                    width="600"
                                    height="400"
                                  />
                                </picture>
                                <a
                                  href={slide.youtube}
                                  data-fancybox={cat.fancyboxGroup}
                                  class="podcast-slide-play"
                                  title="Play Video"
                                >
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="30"
                                    height="30"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                  >
                                    <polygon points="5 3 19 12 5 21 5 3" />
                                  </svg>
                                </a>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                    <div class="swiper__arrows">
                      <div
                        class="swiper__arrow swiper-button-next"
                        tabindex="0"
                        role="button"
                        aria-label="Next slide"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"
                        >
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M9 6l6 6l-6 6" />
                        </svg>
                      </div>
                      <div
                        class="swiper__arrow swiper-button-prev"
                        tabindex="0"
                        role="button"
                        aria-label="Previous slide"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right"
                        >
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M9 6l6 6l-6 6" />
                        </svg>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- All Episodes Section -->

  <section id="section-all-episodes" class="section section-all-episodes pt-0">
    <div class="theme-padding js-scroll fade-in-bottom scrolled">
      <!-- Header Row -->
      <div class="all-episodes-header js-scroll fade-in-top scrolled">
        <div class="all-episodes-title">
          <span class="ae-icon">
