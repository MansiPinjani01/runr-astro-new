                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M15 6l-6 6l6 6"></path>
              </svg>
            </button>
            <button class="ae-nav-btn ae-next-btn" aria-label="Next">
              <svg
                xmlns="http://www.w3.org/2000/svg"
