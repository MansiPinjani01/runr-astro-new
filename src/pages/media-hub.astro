---
/*
  media-hub.astro - Media Hub Page
  Grid auto-generated from src/data/media-hub-reels.json
  Just add reels to the JSON - no HTML editing needed.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import reelsData from "../data/media-hub-reels-fashion.json";

const chapters = reelsData.chapters;
---

<BaseLayout
  title="Media Hub - Runr's Work Across Industries | Real Estate to Retail"
  description="Explore Runr's portfolio by industry - real estate, fashion, jewellery, healthcare, education, and more. See how strategy-led content changes by sector."
  keywords="creative content portfolio India, real estate video production, influencer content by industry, brand content agency India"
  canonical="https://www.runr.in/media-hub/"
  page="media-hub"
  pagename="Media Hub"
  swiperjs={true}
  onepagemenu={true}
>
  <script type="application/ld+json" slot="head" is:inline>{`
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Runr Media Hub - Portfolio by Industry",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Real Estate & Property", "url": "https://www.runr.in/media-hub/property-tours/" },
        { "@type": "ListItem", "position": 2, "name": "Fashion & Lifestyle", "url": "https://www.runr.in/media-hub/fashion/" },
        { "@type": "ListItem", "position": 3, "name": "Jewellery & Luxury", "url": "https://www.runr.in/media-hub/jewellers/" },
        { "@type": "ListItem", "position": 4, "name": "Food & Hospitality", "url": "https://www.runr.in/media-hub/restaurant-cafe/" },
        { "@type": "ListItem", "position": 5, "name": "Education & Learning", "url": "https://www.runr.in/media-hub/education/" },
        { "@type": "ListItem", "position": 6, "name": "Healthcare", "url": "https://www.runr.in/media-hub/hospital/" },
        { "@type": "ListItem", "position": 7, "name": "Events & Experiences", "url": "https://www.runr.in/media-hub/events/" },
        { "@type": "ListItem", "position": 8, "name": "Early Education", "url": "https://www.runr.in/media-hub/pre-school/" },
        { "@type": "ListItem", "position": 9, "name": "Interior & Decor", "url": "https://www.runr.in/media-hub/decor-style/" },
        { "@type": "ListItem", "position": 10, "name": "Food & Confectionery", "url": "https://www.runr.in/media-hub/sweets-desserts/" }
      ]
    }
  `}</script>
  <link
    rel="stylesheet"
    type="text/css"
    href="/media/css/media-hub-grid.css"
    slot="head"
  />

  <section
    id="section-media-hub"
    class="section section-media-hub theme-padding pt-0"
  >
    <div class="columns is-multiline is-vcentered">
      <div
        class="column is-12-mobile is-12-tablet is-7-desktop is-7-widescreen"
      >
        <div class="media-hub-title">
          <div class="section-title title-animate">
            <h1 class="text-md text-uppercase">
              Watch Together.<br /><span class="theme-text text-uppercase"
                >Share Forever.</span
              >
            </h1>
          </div>
          <div class="theme-content-block js-scroll fade-in-right scrolled">
            <div class="theme-content-title">
              <span>Media Hub</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="81"
                height="9"
                viewBox="0 0 81 9"
                fill="none"
              >
                <rect y="4" width="80" height="1" fill="#111013"></rect>
                <path
                  d="M77 7.96366L80.5 4.48183L77 1"
                  stroke="#111013"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <p>
              We don't just capture moments - we solve a different problem for every industry we work in. A jewellery brand needs its content to feel aspirational; a healthcare brand needs it to feel trustworthy; a real estate brand needs it to feel credible before it feels beautiful. Every reel, story, and frame here was built around that distinction first. Browse by industry to see how our thinking changes with the business.
            </p>
          </div>
        </div>
      </div>
      <div
        class="column is-12-mobile is-12-tablet is-5-desktop is-5-widescreen js-scroll fade-in-right scrolled"
      >
        <div class="slider-wrap">
          <div class="hero-slider">
            <div class="phone-stack" id="phoneStack">
              <div class="phone-card" data-i="0">
                <div class="screen">
                  <picture>
                    <img
                      src="/media/images/media-hub/thumb-1.webp"
                      alt="Reels Thumb"
                      width="400"
                      height="715"
                    />
                  </picture>
                </div>
              </div>
              <div class="phone-card" data-i="1">
                <div class="screen">
                  <picture>
                    <img
                      src="/media/images/media-hub/thumb-2.webp"
                      alt="Reels Thumb"
                      width="400"
                      height="715"
                    />
                  </picture>
                </div>
              </div>
              <div class="phone-card" data-i="2">
                <div class="screen">
                  <picture>
                    <img
                      src="/media/images/media-hub/thumb-3.webp"
                      alt="Reels Thumb"
                      width="400"
                      height="715"
                    />
                  </picture>
                </div>
              </div>
              <div class="phone-card" data-i="3">
                <div class="screen">
                  <picture>
                    <img
                      src="/media/images/media-hub/thumb-4.webp"
                      alt="Reels Thumb"
                      width="400"
                      height="715"
                    />
                  </picture>
                </div>
              </div>
              <div class="phone-card" data-i="4">
                <div class="screen">
                  <picture>
                    <img
                      src="/media/images/media-hub/thumb-5.webp"
                      alt="Reels Thumb"
                      width="400"
                      height="715"
                    />
                  </picture>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
   MEDIA HUB - Staggered Masonry Video Grid (auto-generated)
==================================================== -->
  <div class="section media-hub-section theme-padding pt-0">
    <div class="theme-color-shadow"></div>

    <div class="section-title mb-0">
      <h2 class="theme-point title-xs">No two industries sell trust the same way. Here's how that difference shows up in our work.</h2>
    </div>

    {
      chapters.map((chapter, chapterIndex) => (
        <section class="mh-chapter pb-0 pb-0 pt-6">
        
          <div class="mh-chapter-label">
            <div class="section-title title-animate mb-0">
              <h2>{chapter.title}</h2>
            </div>
            {!chapter.noViewMore && (
              <a href={`/media-hub/${chapter.slug}`} class="mh-view-more-btn">
                <span class="mh-btn-text">View More</span>
                <span class="mh-view-more-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="7" y1="17" x2="17" y2="7" />
                    <polyline points="7 7 17 7 17 17" />
                  </svg>
                </span>
              </a>
            )}
          </div>
          <div class={`mh-grid mh-grid--${chapter.pattern}`}>
            {chapter.reels.map((reel) => (
              <div
                class="mh-reel card card-video"
                data-video={reel.video}
                data-poster={reel.poster}
                data-type="portrait"
                data-ratio="9:16"
                tabindex="0"
              >
                <div class="video-poster">
                  <img src={reel.poster} alt={chapter.title} loading="lazy" />
                </div>
                <div class="video-container" />
                <div class="mh-reel-scrim" />
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div><!-- /media-hub-section -->

  <!-- Contact Team Section -->
  <section
    id="section-contact-team"
    class="section-contact-team pb-0 black-bg theme-padding pt-6"
  >
    <div class="columns is-mobile is-multiline is-vcentered contact-team-cols gap-1">
      <div
        class="column is-12-mobile is-12-tablet is-6-desktop is-6-widescreen contact-team-col"
      >
        <div class="section-title dark title-animate">
          <h2>Don't See Your <br /> <span class="theme-text">Industry</span> Here?</h2>
        </div>
        <div class="team-contact-desc dark">
          <p>That's usually the most interesting conversation, not a dealbreaker. Every sector we haven't worked in yet is one we're genuinely excited to think through with you.</p>
          <button
            type="button"
            onclick="openContactSidebar()"
            class="theme-arrow-btn theme-btn btn-primary"
            style="cursor: pointer; border: none;"
          >
            Let's Connect
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M5 12l14 0"></path>
              <path d="M15 16l4 -4"></path>
              <path d="M15 8l4 4"></path>
            </svg>
          </button>
        </div>
      </div>
      <div
        class="column is-12-mobile is-12-tablet is-6-desktop is-6-widescreen contact-team-col"
      >
        <div class="runr-team-img">
          <picture>
            <img src="/media/images/about-us/media-team.webp" alt="Runr Team" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="/media/js/media-hub-video-engine.js"></script>
  <script is:inline src="/media/js/media-hub-grid-reveal.js"></script>

  <Fragment slot="page-scripts">
    <script is:inline>
      (function () {
        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const stack = document.getElementById("phoneStack");
        if (!stack) return;
        const cards = Array.from(stack.querySelectorAll(".phone-card"));
        const n = cards.length;
        const centerIndex = Math.floor(n / 2);

        function layout(animate) {
          const w = stack.getBoundingClientRect().width;
          const spacing = w * 0.155;
          cards.forEach((card, i) => {
            const off = i - centerIndex;
            const x = off * spacing;
            const scale = Math.max(1 - Math.abs(off) * 0.12, 0.62);
            const rot = off * 11;
            const opacity = 1 - Math.abs(off) * 0.28;
            const z = 10 - Math.abs(off);
            card.classList.toggle("is-active", off === 0);
            gsap.to(card, {
              x,
              y: Math.abs(off) * 14,
              scale,
              rotate: rot,
              opacity,
              zIndex: z,
              duration: animate ? 0.9 : 0,
              ease: "power3.out",
            });
          });
        }

        cards.forEach((card) => {
          card.addEventListener("mouseenter", () => {
            if (reduceMotion) return;
            gsap.to(card, {
              scale: "+=0.04",
              duration: 0.35,
              ease: "power2.out",
              overwrite: "auto",
            });
          });
          card.addEventListener("mouseleave", () => layout(true));
        });

        window.addEventListener("resize", () => layout(false));
        layout(false);
      })();
    </script>
  </Fragment>
</BaseLayout>
