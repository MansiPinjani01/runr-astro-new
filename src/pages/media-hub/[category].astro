---
/*
  [category].astro — Dynamic Reels Category Page
  Parallax scrolling wall with Lenis smooth scroll integration.
*/
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

export function getStaticPaths() {
  const files = import.meta.glob("../../data/reels/*.json", { eager: true });
  return Object.entries(files).map(([path, mod]: [string, any]) => {
    const slug = path.split("/").pop()!.replace(".json", "");
    const data = mod.default || mod;
    return {
      params: { category: slug },
      props: { data },
    };
  });
}

interface ReelItem {
  video: string;
  poster: string;
  title: string;
}

interface CategoryData {
  category: string;
  title: string;
  description: string;
  keywords?: string;
  metaDescription?: string;
  reels: ReelItem[];
}

const { data } = Astro.props as { data: CategoryData };
const categorySlug = Astro.params.category;
const categoryTitle = data.title;
const reels = data.reels;

const metaTitle = `${categoryTitle} Video Content & Reel Production | Runr`;
const metaDescription =
  data.metaDescription ||
  `Explore Runr's strategy-led ${categoryTitle.toLowerCase()} reels, video content, and brand campaigns. Built for engagement and growth.`;
const metaKeywords =
  data.keywords ||
  `${categoryTitle.toLowerCase()} video content, ${categoryTitle.toLowerCase()} reel production, ${categoryTitle.toLowerCase()} marketing strategy`;
const canonicalUrl = `https://www.runr.in/media-hub/${categorySlug}/`;

// Helper: convert YouTube hqdefault to smaller mqdefault (320x180 vs 480x360)
function getSmallPoster(poster: string): string {
  if (poster && poster.includes("hqdefault")) {
    return poster.replace("hqdefault", "mqdefault");
  }
  return poster;
}

// Prepare columns: 5 columns for desktop grid
function getColumns(allReels: ReelItem[]) {
  const NUM_COLS = 5;
  const ITEMS_PER_COL = Math.max(3, Math.ceil(allReels.length / NUM_COLS));
  const cols: ReelItem[][] = Array.from({ length: NUM_COLS }, () => []);
  for (let c = 0; c < NUM_COLS; c++) {
    for (let i = 0; i < ITEMS_PER_COL; i++) {
      cols[c].push(allReels[(c * ITEMS_PER_COL + i) % allReels.length]);
    }
  }
  return cols;
}
const columns = getColumns(reels);
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  keywords={metaKeywords}
  canonical={canonicalUrl}
  page="media-hub-category"
  pagename={categoryTitle}
  bodyClass="reels-category-page"
>
  <link
    rel="stylesheet"
    type="text/css"
    href="/media/css/reels-category.css"
    slot="head"
  />
  <style slot="head">
    /* Placeholder bg for lazy images before they load */
    img.rc-lazy {
      background: #1a1a1a;
      min-height: 100%;
    }
  </style>

  <section class="rc-parallax-page media-hub-section" id="parallaxPage">
    <div class="rc-columns-wrap" id="columnsWrap">
      {
        columns.map((col, colIdx) => (
          <div
            class="rc-col"
            data-speed={["-420", "260", "-320", "460", "-280"][colIdx]}
            style={`margin-top: ${["-80px", "60px", "-40px", "80px", "-20px"][colIdx]}`}
          >
            {col.map((reel) => (
              <div
                class="rc-reel-thumb card card-video"
                data-video={reel.video}
                data-poster={reel.poster}
                data-type="portrait"
                data-ratio="9:16"
              >
                <div class="video-poster">
                  <img
                    src=""
                    data-src={getSmallPoster(reel.poster)}
                    alt={reel.title}
                    loading="lazy"
                    decoding="async"
                    class="rc-lazy"
                  />
                </div>
                <div class="video-container" />
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div class="rc-hero-overlay" id="heroOverlay">
      <h1>{categoryTitle}</h1>
      <div class="rc-scroll-cue"><span class="rc-line"></span>Scroll</div>
    </div>
  </section>

  <script is:inline src="/media/js/media-hub-video-engine.js"></script>

  <Fragment slot="page-scripts">
    <!-- Intersection Observer lazy-load for thumbnails -->
    <script is:inline>
      (function () {
        var imgs = document.querySelectorAll("img.rc-lazy");
        if ("IntersectionObserver" in window) {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  var img = entry.target;
                  img.src = img.getAttribute("data-src");
                  img.classList.remove("rc-lazy");
                  observer.unobserve(img);
                }
              });
            },
            { rootMargin: "200px 0px" },
          );
          imgs.forEach(function (img) {
            observer.observe(img);
          });
        } else {
          // Fallback: load all immediately
          imgs.forEach(function (img) {
            img.src = img.getAttribute("data-src");
          });
        }
      })();
    </script>

    <script is:inline>
      (function () {
        function init() {
          if (
            typeof gsap === "undefined" ||
            typeof ScrollTrigger === "undefined"
          ) {
            setTimeout(init, 50);
            return;
          }

          gsap.registerPlugin(ScrollTrigger);

          // Connect Lenis to ScrollTrigger (if not already connected)
          if (window.lenis) {
            window.lenis.on("scroll", ScrollTrigger.update);
            gsap.ticker.add(function (time) {
              window.lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);
          }

          var page = document.getElementById("parallaxPage");
          if (!page) return;

          var cols = page.querySelectorAll(".rc-col");

          cols.forEach(function (col) {
            var speed = parseFloat(col.getAttribute("data-speed")) || 0;
            gsap.to(col, {
              y: speed,
              ease: "none",
              force3D: true,
              scrollTrigger: {
                trigger: page,
                start: "top top",
                end: "bottom bottom",
                scrub: 0.8,
              },
            });
          });

          // Fade hero text
          gsap.to("#heroOverlay", {
            opacity: 0,
            y: -50,
            ease: "none",
            scrollTrigger: {
              trigger: page,
              start: "top top",
              end: "25% top",
              scrub: 0.8,
            },
          });

          ScrollTrigger.refresh();
        }

        // Wait for everything to be ready
        window.addEventListener("load", init);
      })();
    </script>
  </Fragment>
</BaseLayout>
