---
/*
  team-and-culture.astro - Team and Culture Page
  Converted from PHP: index.php
  All PHP variables replaced with static paths.
  HTML structure preserved exactly as original.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Team And Culture - runr"
  page="team-and-culture"
  pagename="Team and Culture"
  slider={true}
  swiperjs={true}
  counter={true}
  onepagemenu={true}
>

  <section id="section-about-us" class="section section-about-us">
    <div class="theme-padding about-us-wrapper js-scroll fade-in-left scrolled">
      <div class="move-box"></div>
      <div class="theme-content-title mb-4">
        <span>Team and Culture</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="81" height="9" viewBox="0 0 81 9" fill="none">
          <rect y="4" width="80" height="1" fill="#111013"></rect>
          <path d="M77 7.96366L80.5 4.48183L77 1" stroke="#111013" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <div class="section-title title-animate">
        <h1 class="text-xl text-uppercase">Meet the mins. <br><span class="theme-text text-uppercase">behind the magic.</span></h1>
      </div>
      <div class="theme-content-block js-scroll fade-in-right scrolled">
        <p>Behind every successful campaign is a team driven by passion, teamwork, and a shared vision. At Runr, we create an environment where creativity thrives and every voice helps shape extraordinary content.</p>
      </div>
    </div>
  </section>


  <!-- Team Leader -->

  <section id="section-team-leader" class="section-founder-hero theme-padding pb-0">
    <div class="founder-inner">
      <div class="columns is-multiline is-vcentered">
        <!-- Left Column: Photo -->
        <div class="column is-12-mobile is-12-tablet is-4-desktop">
          <div class="founder-photo-wrap">
            <div class="founder-photo">
              <img src="/media/images/team-culture/team-leader/founder-img.webp" alt="Sagar Goswami - Founder">
            </div>
          </div>
        </div>
        <!-- Right Column: All Content -->
        <div class="column is-12-mobile is-12-tablet is-8-desktop">
          <div class="founder-right dark">
            <span class="text-xs">Co-Founder & CEO</span>
            <h2 class="founder-name">Sagar Goswami</h2>
            <div class="founder-quote">
              <span class="quote-text">True growth is not about adding more, but about becoming more.</span>
            </div>
            <div class="founder-desc dark text-xs">
              <p>At Runr, we believe that creativity isn't just about content - it's about connecting people, emotions, and purpose.</p>
              <p>This platform was born from a passion to reshape how brands speak, how creators express, and how audiences engage.</p>
              <p>Our vision is not limited to trends - we’re here to set bold milestones, build meaningful collaborations, and challenge the ordinary. Every reel, every podcast, every campaign we create is a step towards a more expressive, authentic, and exciting digital future.</p>
              <p>As the founder of Runr, I’m committed to nurturing talent, bringing fresh ideas to life, and building a brand that not only grows - but leads. Let’s keep pushing boundaries, together.</p>
              <p class="founder-belief">Great Brands Aren't Built By Chance - They're Built By Vision, People, And Purpose.</p>
            </div>

            <div class="counter-block-wrapper">
              <div class="columns is-multiline is-mobile about-company-cols justify-content-center">
                <div class="column about-company-col">
                  <div class="about-company-item">
                    <div class="counter-block dark">
                      <h3 class="counter">
                        <span data-purecounter-start="0" data-purecounter-end="250" data-purecounter-separator="true" data-purecounter-separatorsymbol="," data-purecounter-once="false" data-purecounter-once="true" class="purecounter" id="myForm3">0</span>+
                      </h3>
                      <p>Influencer Partnerships</p>
                    </div>
                  </div>
                </div>
                <div class="column about-company-col">
                  <div class="about-company-item">
                    <div class="counter-block dark">
                      <h3 class="counter">
                        <span data-purecounter-start="0" data-purecounter-end="100" data-purecounter-separator="true" data-purecounter-separatorsymbol="," data-purecounter-once="false" data-purecounter-once="true" class="purecounter" id="myForm3">0</span>+
                      </h3>
                      <p>Brand Collaborations</p>
                    </div>
                  </div>
                </div>
                <div class="column about-company-col">
                  <div class="about-company-item">
                    <div class="counter-block dark">
                      <h3 class="counter">
                        <span data-purecounter-start="0" data-purecounter-end="5" data-purecounter-separator="true" data-purecounter-separatorsymbol="," data-purecounter-once="false" data-purecounter-once="true" class="purecounter" id="myForm3">0</span>M+
                      </h3>
                      <p>Audience Reach</p>
                    </div>
                  </div>
                </div>
                <div class="column about-company-col">
                  <div class="about-company-item">
                    <div class="counter-block dark">
                      <h3 class="counter">
                        <span data-purecounter-start="0" data-purecounter-end="1200" data-purecounter-separator="true" data-purecounter-separatorsymbol="," data-purecounter-once="false" data-purecounter-once="true" class="purecounter" id="myForm3">0</span>+
                      </h3>
                      <p>Video/Podcast Content</p>
                    </div>
                  </div>
                </div>
                <div class="column about-company-col">
                  <div class="about-company-item">
                    <div class="counter-block dark">
                      <h3 class="counter">
                        <span data-purecounter-start="0" data-purecounter-end="54" data-purecounter-separator="true" data-purecounter-separatorsymbol="," data-purecounter-once="false" data-purecounter-once="true" class="purecounter" id="myForm3">0</span>k+
                      </h3>
                      <p>Followers</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Creative Team -->

  <!-- Creative Team Scattered Scroll Section -->
  <section id="section-creative-team" class="section-creative-team-hero">
    <div class="team-hero-rail"></div>
    <div class="team-img-stream" id="teamImgStream"></div>
    <div class="team-heading-block">
      <div class="team-cat-pill-wrap">
        <div class="team-cat-pill-track" id="teamPillTrack"></div>
      </div>
      <!-- <h2 class="team-hero-heading">Our Creative<br>Team</h2> -->
      <div class="section-title title-animate">
        <h2 class="text-xl">Our <br> <span class="text-xl theme-text"> Creative</span> <br>
          <span>Team</span>
        </h2>

      </div>
      <p class="team-hero-subtext" id="teamCatDesc">Every idea that turns into a reel, campaign, or podcast starts here with our passionate, multi-talented creative minds.</p>
    </div>
  </section>

  <section id="section-contact-team" class="section-contact-team pb-0 black-bg theme-padding">
    <div class="columns is-multiline is-vcentered">
      <div class="column is-12-mobile is-12-tablet is-4-desktop is-4-widescreen">
        <div class="section-title dark title-animate">
          <h2>Redy to Create <br> Something <br>Extraordinary</h2>
        </div>
      </div>
      <div class="column is-12-mobile is-12-tablet is-5-desktop is-5-widescreen">
        <div class="runr-team-img">
          <picture>
            <img src="/media/images/team-culture/runr-team.webp" alt="Runr Team">
          </picture>
        </div>
      </div>
      <div class="column is-12-mobile is-12-tablet is-3-desktop is-3-widescreen">
        <div class="team-contact-desc dark">
          <p>Let's build Something Iconic Togather</p>
          <a href="../contact-us/" class="theme-arrow-btn theme-btn btn-primary">Let's Connect
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M5 12l14 0" />
              <path d="M15 16l4 -4" />
              <path d="M15 8l4 4" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section><!-- Creative Team Scattered Scroll -->
  

  <!-- Founder Section Animations -->
  

<Fragment slot="page-scripts">
<script is:inline>
    (function() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      gsap.registerPlugin(ScrollTrigger);

      var CATEGORIES = [{
          name: "The Growth Gurus",
          desc: "The strategists behind every successful campaign. They transform ideas into measurable growth through smart planning, data-driven decisions, and innovative marketing strategies."
        },
        {
          name: "Social Impact Maker",
          desc: "The voices that build meaningful connections. From influencer collaborations to community engagement, they create authentic stories that inspire trust and drive real impact."
        },
        {
          name: "Creative Crew",
          desc: "The designers, editors, filmmakers, and storytellers who bring every vision to life. They turn imagination into compelling visuals and content that captures attention and leaves a lasting impression."
        },
      ];
      var PER_CATEGORY = 3;

      var ALL_IMAGES = [{
          src: "/media/images/team-culture/growth-guru/growth-guru-img3.webp",
          cat: 0
        },
        {
          src: "/media/images/team-culture/growth-guru/growth-guru-img2.webp",
          cat: 0
        },
        {
          src: "/media/images/team-culture/growth-guru/growth-guru-img4.webp",
          cat: 0
        },
        {
          src: "/media/images/team-culture/social-impact/social-impact-img2.webp",
          cat: 1
        },
        {
          src: "/media/images/team-culture/social-impact/social-impact-img1.webp",
          cat: 1
        },
        {
          src: "/media/images/team-culture/creative-crew/creative-crew-img9.webp",
          cat: 2
        },
        {
          src: "/media/images/team-culture/creative-crew/creative-crew-img5.webp",
          cat: 2
        },
        {
          src: "/media/images/team-culture/creative-crew/creative-crew-img3.webp",
          cat: 2
        },
        {
          src: "/media/images/team-culture/creative-crew/creative-crew-img7.webp",
          cat: 2
        },
        {
          src: "/media/images/team-culture/creative-crew/creative-crew-img4.webp",
          cat: 2
        },
        {
          src: "/media/images/team-culture/creative-crew/creative-crew-img2.webp",
          cat: 2
        },
        {
          src: "/media/images/team-culture/creative-crew/creative-crew-img1.webp",
          cat: 2
        },
      ];

      // Seeded random - 3 columns, no tilt, animated entrance
      function seededRandom(seed) {
        var s = seed;
        return function() {
          s = (s * 9301 + 49297) % 233280;
          return s / 233280;
        };
      }
      var rnd = seededRandom(42);
      var SIDES = ['left', 'right'];
      var MEMBER_DATA = [{
          name: 'Suhas Kalyan',
          role: 'Growth Guru'
        },
        {
          name: 'Gurmeet Singh',
          role: 'Growth Guru'
        },
        {
          name: 'Prashant Solanki',
          role: 'Growth Guru'
        },
        {
          name: 'Khushbu Rathod',
          role: 'Social Impact'
        },
        {
          name: 'Nirvik Dobariya',
          role: 'Social Impact'
        },
        {
          name: 'Roman Vegad',
          role: 'Creative Crew'
        },
        {
          name: 'Harshil Rathod',
          role: 'Creative Crew'
        },
        {
          name: 'Noopur Jadav',
          role: 'Creative Crew'
        },
        {
          name: 'Janmejay Chaturvedi',
          role: 'Creative Crew'
        },
        {
          name: 'Parthraj Vala',
          role: 'Creative Crew'
        },
        {
          name: 'Kalpesh Katariya',
          role: 'Creative Crew'
        },
        {
          name: 'Jay Bhutaiya',
          role: 'Creative Crew'
        }
      ];
      var LAYOUT = ALL_IMAGES.map(function(_, i) {
        var side = SIDES[i % 2];
        var band = side === 'left' ? {
          start: 6,
          width: 22
        } : {
          start: 60,
          width: 22
        };
        return {
          side: side,
          leftPct: band.start + rnd() * band.width,
          jitter: (rnd() - 0.5) * 50,

        };
      });

      // Build pills
      var pillTrack = document.getElementById('teamPillTrack');
      CATEGORIES.forEach(function(c, i) {
        var el = document.createElement('div');
        el.className = 'team-cat-pill';
        el.innerHTML = c.name + ' <span class="n">0' + (i + 1) + '/0' + CATEGORIES.length + '</span>';
        pillTrack.appendChild(el);
      });
      var PILL_H = 28;

      // Build cards with name tags + center class + initial hidden state
      var streamEl = document.getElementById('teamImgStream');
      var cardEls = [];
      ALL_IMAGES.forEach(function(img, i) {
        var card = document.createElement('div');
        var isCenter = false;
        card.className = 't-card' + (isCenter ? ' center' : '');
        card.dataset.cat = img.cat;
        var member = MEMBER_DATA[i] || {
          name: 'Team Member',
          role: ''
        };
        card.innerHTML = '<img src="' + img.src + '" alt="' + member.name + '" width="260" height="340" loading="' + (i < 4 ? 'eager' : 'lazy') + '"><div class="t-tag"><div class="t-name">' + member.name + '</div><div class="t-role">' + member.role + '</div></div>';
        card.style.pointerEvents = 'auto';
        card.style.opacity = '0';
        card.style.transform = 'translateY(60px) scale(0.85)';
        streamEl.appendChild(card);
        cardEls.push(card);
      });

      // Category sync
      var currentCat = -1;
      var catDescEl = document.getElementById('teamCatDesc');

      function setCategory(ci) {
        if (ci === currentCat) return;
        currentCat = ci;
        gsap.to(pillTrack, {
          y: -ci * PILL_H,
          duration: .5,
          ease: "power3.out",
          overwrite: true
        });
        gsap.fromTo(catDescEl, {
          opacity: 0,
          y: 6
        }, {
          opacity: 1,
          y: 0,
          duration: .4,
          ease: "power2.out",
          overwrite: true
        });
        catDescEl.textContent = CATEGORIES[ci].desc;
      }
      setCategory(0);

      // Layout
      var st;
      var maxScroll = 0;

      function layout() {
        var vw = window.innerWidth;
        var isMobile = vw < 700;
        var cardW = isMobile ? Math.round(vw * 0.32) : Math.min(Math.max(vw * 0.16, 150), 250);
        var cardH = Math.round(cardW * 1.32);
        var centerW = Math.round(cardW * 0.72);
        var centerH = Math.round(centerW * 1.32);
        var baseGap = isMobile ? 90 : 120;
        var cumTop = cardH * 0.6;

        cardEls.forEach(function(card, i) {
          var L = LAYOUT[i];
          var isCenter = !isMobile && L.side === 'center';
          var leftPct;
          if (isMobile) {
            leftPct = (i % 2 === 0) ? 1 + (L.leftPct % 10) : 68 - (L.leftPct % 10);
          } else {
            leftPct = L.leftPct;
          }
          var w = isCenter ? centerW : cardW;
          var h = isCenter ? centerH : cardH;
          var gap = isCenter ? baseGap * 0.7 : baseGap;
          cumTop += gap + (isMobile ? L.jitter * 0.4 : (isCenter ? L.jitter * 0.5 + L.topOffset * 0.6 : L.jitter));
          card.style.width = w + 'px';
          card.style.height = h + 'px';
          card.style.left = leftPct + '%';
          card.style.top = cumTop + 'px';
          cumTop += h;
        });

        maxScroll = Math.max(cumTop - window.innerHeight * 0.7, 400);
      }

      function buildScroll() {
        if (st) st.kill();
        gsap.set(streamEl, {
          y: 0
        });
        layout();

        st = ScrollTrigger.create({
          trigger: "#section-creative-team",
          start: "top top",
          end: function() {
            return "+=" + Math.round(maxScroll * 1.15);
          },
          pin: true,
          anticipatePin: 1,
          scrub: true,
          invalidateOnRefresh: true,
          onUpdate: function(self) {
            var p = self.progress;
            gsap.set(streamEl, {
              y: -p * maxScroll,
              force3D: true
            });
            var ci = Math.min(CATEGORIES.length - 1, Math.floor(p * CATEGORIES.length));
            setCategory(ci);

            // Animate cards into view as they enter viewport
            var vh = window.innerHeight;
            var streamY = -p * maxScroll;
            cardEls.forEach(function(card, i) {
              var cardTop = parseFloat(card.style.top) + streamY;
              var isCenter = false;
              // Card is in viewport zone
              if (cardTop > -100 && cardTop < vh + 100) {
                var reveal = Math.min(1, Math.max(0, (vh - cardTop) / (vh * 0.5)));
                card.style.opacity = '' + reveal;
                card.style.transform = 'translateY(' + ((1 - reveal) * 60) + 'px) scale(' + (0.85 + reveal * 0.15) + ')';
              } else {
                card.style.opacity = '0';
                card.style.transform = 'translateY(60px) scale(0.85)';
              }
            });
          }
        });
      }

      // Init
      requestAnimationFrame(function() {
        requestAnimationFrame(buildScroll);
      });

      var rTO;
      window.addEventListener('resize', function() {
        clearTimeout(rTO);
        rTO = setTimeout(buildScroll, 200);
      });
    })();
  </script>
<script is:inline>
    (function() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      gsap.registerPlugin(ScrollTrigger);

      var founderSection = document.querySelector('.section-founder-hero');
      if (!founderSection) return;

      // Quote text fill on scroll
      var quoteText = founderSection.querySelector('.founder-quote .quote-text');
      if (quoteText) {
        gsap.fromTo(quoteText, { '--fill': '0%' }, {
          '--fill': '100%',
          ease: 'none',
          scrollTrigger: {
            trigger: quoteText,
            start: 'top 85%',
            end: 'top 40%',
            scrub: 1
          }
        });
      }

      // Counters - stagger fade up
      var counters = founderSection.querySelectorAll('.about-company-col');
      if (counters.length) {
        gsap.fromTo(counters, { y: 30, opacity: 0 }, {
          y: 0, opacity: 1, duration: 0.6, stagger: 0.1, ease: 'power3.out',
          scrollTrigger: { trigger: '.counter-block-wrapper', start: 'top 85%', once: true }
        });
      }

      // Photo - scale reveal
      var photo = founderSection.querySelector('.founder-photo img');
      if (photo) {
        gsap.set(photo, { scale: 1.3, opacity: 0 });
        ScrollTrigger.create({
          trigger: founderSection,
          start: 'top 50%',
          once: true,
          onEnter: function() {
            gsap.to(photo, { scale: 1, opacity: 1, duration: 1.2, ease: 'power3.out' });
          }
        });
      }

      // Name - letter spacing compress (starts wide, compresses to normal)
      var name = founderSection.querySelector('.founder-name');
      if (name) {
        gsap.set(name, { letterSpacing: '15px', opacity: 0, filter: 'blur(4px)' });
        ScrollTrigger.create({
          trigger: founderSection,
          start: 'top 50%',
          once: true,
          onEnter: function() {
            gsap.to(name, { letterSpacing: '0px', opacity: 1, filter: 'blur(0px)', duration: 1, delay: 0.3, ease: 'power2.out' });
          }
        });
      }
    })();
  </script>
</Fragment>

</BaseLayout>
