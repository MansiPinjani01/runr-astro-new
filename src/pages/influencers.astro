              <span class="beyond-chip">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                Brands
              </span>
              <span class="beyond-chip">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-3.05 11a22.35 22.35 0 0 1-3.95 2z"></path></svg>
                Entrepreneurs
              </span>
            </div>
            <button
              type="button"
              onclick="openContactSidebar()"
              class="theme-arrow-btn theme-btn btn-primary"
              style="cursor: pointer; border: none;"
            >
              Tell Us About It
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M5 12l14 0"></path>
                <path d="M15 16l4 -4"></path>
                <path d="M15 8l4 4"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
      <div
        class="column is-12-mobile is-12-tablet is-6-desktop is-6-widescreen contact-team-col"
      >
        <div class="runr-team-img js-scroll fade-in-right scrolled">
          <picture>
            <img src="/media/images/about-us/influencers-team.webp" alt="Runr Influencer Team" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="page-scripts">
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        const cards = document.querySelectorAll(".influencers-col");

        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                const index = parseInt(entry.target.getAttribute("data-index"));
                setTimeout(function () {
                  entry.target.classList.add("is-visible");
                }, index * 100);
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );

        cards.forEach(function (card) {
          observer.observe(card);
        });

        // Split text for influencer hover animation
        const elements = document.querySelectorAll('.influencer-name-wrap .txt');
        elements.forEach(function(el) {
          const text = el.textContent.trim();
          el.textContent = '';
          text.split('').forEach(function (letter, i) {
            const ch = document.createElement('span');
            ch.className = 'ch';
            ch.textContent = letter === ' ' ? '\u00A0' : letter;
            ch.style.transitionDelay = (i * 0.02) + 's';
            el.appendChild(ch);
          });
        });
      });
    </script>
  </Fragment>
</BaseLayout>
